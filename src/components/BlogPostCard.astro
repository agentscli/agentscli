---
// Blog Post Card Component - Figma Design
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image?: ImageMetadata | string | null;
  category: string;
  date: string;
  title: string;
  description: string;
  authorInitials: string;
  authorName: string;
  readTime: string;
  href?: string;
  tags?: string[];
}

const {
  image,
  category,
  date,
  title,
  description,
  authorInitials,
  authorName,
  readTime,
  href = "#",
  tags = []
} = Astro.props;

const fallbackInitial = title.trim().charAt(0).toUpperCase() || "?";
const hasImage = image != null;
const isImageMeta = hasImage && typeof image !== "string";
---

<article class="post-card" data-track="blog-card" data-category={category.toLowerCase()}>
  <a href={href} class="post-image-link" aria-label={title}>
    <div class="post-image-container">
      {isImageMeta ? (
        <Image
          src={image as ImageMetadata}
          alt={title}
          class="post-image"
          widths={[270, 540, 810]}
          sizes="(max-width: 900px) 100vw, 270px"
          loading="lazy"
        />
      ) : hasImage ? (
        <img src={image as string} alt={title} class="post-image" loading="lazy" />
      ) : (
        <div class="post-image-fallback" aria-hidden="true">
          <span class="fallback-initial">{fallbackInitial}</span>
        </div>
      )}
    </div>
  </a>
  <div class="post-content">
    <div class="post-meta">
      <span class="post-category">{category}</span>
      <span class="meta-separator">•</span>
      <span class="post-date">{date}</span>
    </div>
    <h2 class="post-title">
      <a href={href}>{title}</a>
    </h2>
    <p class="post-description">{description}</p>
    <div class="post-footer">
      <div class="author-info">
        <div class="author-avatar">
          <span class="author-initials">{authorInitials}</span>
        </div>
        <span class="author-name">{authorName}</span>
      </div>
      <span class="read-time">{readTime}</span>
    </div>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .post-image-link {
    flex-shrink: 0;
    text-decoration: none;
  }

  .post-image-container {
    width: 270px;
    aspect-ratio: 4/3;
    background: var(--ac-surface);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 12px;
    overflow: hidden;
  }

  .post-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-image-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(
      ellipse at 30% 30%,
      rgba(124, 105, 247, 0.15) 0%,
      var(--sl-color-bg) 70%
    );
  }

  .fallback-initial {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 88px;
    font-weight: 800;
    color: rgba(124, 105, 247, 0.35);
    line-height: 1;
    user-select: none;
  }

  .post-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .post-category {
    font-family: 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    font-weight: 500;
    color: var(--sl-color-text-accent);
  }

  .meta-separator {
    font-family: 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    font-weight: 400;
    color: var(--sl-color-gray-2);
  }

  .post-date {
    font-family: 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    font-weight: 400;
    color: var(--sl-color-gray-2);
    text-transform: uppercase;
  }

  .post-title {
    margin: 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 24px;
    font-weight: 700;
    line-height: 30px;
    color: var(--sl-color-white);
  }

  .post-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-title a:hover {
    color: var(--sl-color-text-accent);
  }

  .post-description {
    margin: 0;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 26px;
    color: var(--sl-color-gray-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 8px;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .author-avatar {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(124, 105, 247, 0.2);
    border: 1px solid rgba(124, 105, 247, 0.3);
    border-radius: 9999px;
  }

  .author-initials {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 700;
    color: var(--sl-color-text-accent);
  }

  .author-name {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: var(--sl-color-gray-2);
  }

  .read-time {
    font-family: 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    font-weight: 400;
    color: var(--sl-color-gray-2);
  }

  @media (max-width: 900px) {
    .post-card {
      flex-direction: column;
      gap: 20px;
    }

    .post-image-container {
      width: 100%;
      max-width: 400px;
    }

    .post-content {
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: 20px;
      line-height: 26px;
    }

    .post-description {
      font-size: 14px;
      line-height: 22px;
    }
  }
</style>
