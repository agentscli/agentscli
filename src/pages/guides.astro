---
// Guides Landing Page - agents.cli
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuidesSidebar from "../components/GuidesSidebar.astro";
import GuidesContent from "../components/GuidesContent.astro";
import GuidesToc from "../components/GuidesToc.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Learn about AI Agents, Skills, Commands, and Rules - agents.cli documentation"
    />
    <title>Guides - agents.cli</title>
    <Head />
  </head>
  <body>
    <div class="guides-container">
      <div class="grid-background"></div>
      <div class="grid-gradient"></div>
      <Header />
      <main class="guides-main">
        <div class="guides-layout">
          <!-- Left Sidebar -->
          <GuidesSidebar />

          <!-- Main Content Area -->
          <GuidesContent />

          <!-- Right Sidebar (Table of Contents) -->
          <GuidesToc />
        </div>
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: "Space Grotesk", system-ui, sans-serif;
  }

  body {
    background-color: #0a0a0f;
    color: #ffffff;
    min-height: 100vh;
  }
</style>

<style>
  .guides-container {
    background-color: #0a0a0f;
    color: #ffffff;
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
  }

  .grid-background {
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(
        90deg,
        rgba(124, 105, 247, 0.05) 2.5%,
        rgba(124, 105, 247, 0) 2.5%
      ),
      linear-gradient(
        180deg,
        rgba(124, 105, 247, 0.05) 2.5%,
        rgba(124, 105, 247, 0) 2.5%
      );
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .grid-gradient {
    position: fixed;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10, 10, 15, 0) 0%,
      rgba(10, 10, 15, 0.5) 50%,
      #0a0a0f 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  .guides-main {
    position: relative;
    z-index: 1;
  }

  .guides-layout {
    display: flex;
    max-width: 100%;
    min-height: calc(100vh - 65px);
  }

  @media (max-width: 1200px) {
    .guides-layout :global(.guides-toc) {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .guides-layout :global(.guides-sidebar) {
      display: none;
    }
  }
</style>
