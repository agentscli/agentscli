---
// Footer Component
---

<footer class="homepage-footer">
  <div class="footer-container">
    <div class="footer-left">
      <svg class="footer-logo" width="12" height="12" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" fill="rgba(255,255,255,0.4)"/>
      </svg>
      <span class="footer-copyright">2024 agents.cli — All systems operational.</span>
    </div>
    <div class="footer-links">
      <a href="/guides/getting-started" class="footer-link">Documentation</a>
      <a href="/blog" class="footer-link">Changelog</a>
      <a href="/privacy" class="footer-link">Privacy</a>
    </div>
  </div>
</footer>

<style>
  .homepage-footer {
    padding: 49px 80px 48px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
    z-index: 1;
  }

  .footer-container {
    max-width: 1152px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .footer-logo {
    width: 11.667px;
    height: 11.667px;
  }

  .footer-copyright {
    font-family: 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.4);
  }

  .footer-links {
    display: flex;
    gap: 32px;
  }

  .footer-link {
    font-family: 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: #ffffff;
  }

  @media (max-width: 768px) {
    .homepage-footer {
      padding: 32px 24px;
    }

    .footer-container {
      flex-direction: column;
      gap: 24px;
      text-align: center;
    }

    .footer-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px;
    }
  }
</style>
