---
// Related posts - compact 3-up grid shown after the article body.
// Selection (tag overlap) happens in the page; this component only renders.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface RelatedPost {
  href: string;
  title: string;
  description?: string;
  tag?: string;
  date: string;
  hero: ImageMetadata | null;
}

interface Props {
  posts: RelatedPost[];
}

const { posts } = Astro.props;

function formatDate(date: string): string {
  return new Date(date).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}
---

{
  posts.length > 0 && (
    <section class="related-posts" aria-labelledby="related-posts-title">
      <h2 class="related-title" id="related-posts-title">
        Keep reading
      </h2>
      <div class="related-grid">
        {posts.map((post) => (
          <a href={post.href} class="related-card">
            <div class="related-thumb">
              {post.hero ? (
                <Image
                  src={post.hero}
                  alt=""
                  widths={[320, 640]}
                  sizes="(max-width: 768px) 100vw, 320px"
                  loading="lazy"
                />
              ) : (
                <div class="related-thumb-fallback" aria-hidden="true">
                  <span>{post.title.trim().charAt(0).toUpperCase()}</span>
                </div>
              )}
            </div>
            <div class="related-meta">
              {post.tag && <span class="related-tag">{post.tag}</span>}
              <time class="related-date">{formatDate(post.date)}</time>
            </div>
            <h3 class="related-card-title">{post.title}</h3>
            {post.description && (
              <p class="related-description">{post.description}</p>
            )}
          </a>
        ))}
      </div>
    </section>
  )
}

<style>
  .related-posts {
    max-width: 900px;
    margin: 0 auto;
    padding: 48px 24px 16px;
    border-top: 1px solid var(--border-subtle);
    /* Sit above the page-wide .grid-gradient overlay, like the other sections. */
    position: relative;
    z-index: 1;
  }

  .related-title {
    margin: 0 0 28px;
    font-family: "Fira Code", monospace;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    min-width: 0;
  }

  .related-thumb {
    aspect-ratio: 16/10;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--surface-bg);
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .related-card:hover .related-thumb {
    border-color: var(--accent-border);
    box-shadow: 0 0 18px var(--accent-soft);
  }

  .related-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .related-thumb-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(
      ellipse at 30% 30%,
      var(--accent-soft) 0%,
      var(--surface-bg) 75%
    );
  }

  .related-thumb-fallback span {
    font-size: 44px;
    font-weight: 700;
    color: var(--accent);
    opacity: 0.5;
    line-height: 1;
    user-select: none;
  }

  .related-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: "Fira Code", monospace;
    font-size: 11px;
  }

  .related-tag {
    color: var(--accent);
  }

  .related-date {
    color: var(--text-dim);
    text-transform: uppercase;
  }

  .related-card-title {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text-primary);
    transition: color 0.2s ease;
  }

  .related-card:hover .related-card-title {
    color: var(--accent);
  }

  .related-description {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .related-grid {
      grid-template-columns: 1fr;
    }

    .related-posts {
      padding: 36px 20px 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .related-thumb,
    .related-card-title {
      transition: none !important;
    }
  }
</style>
