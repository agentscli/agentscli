---
// Guides Main Content Component
import GuideCard from "./GuideCard.astro";
---

<div class="guides-content">
  <!-- Breadcrumb Header -->
  <header class="content-header">
    <div class="breadcrumb">
      <span class="breadcrumb-item">Docs</span>
      <svg class="breadcrumb-separator" width="4" height="6" viewBox="0 0 4 6" fill="none">
        <path d="M0 0L4 3L0 6V0Z" fill="#64748b"/>
      </svg>
      <span class="breadcrumb-item active">Guides</span>
    </div>
    <div class="header-actions">
      <div class="search-box">
        <svg class="search-icon" width="14" height="14" viewBox="0 0 14 14" fill="none">
          <circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.5" fill="none"/>
          <path d="M10 10L13 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <input type="text" placeholder="Search documentation..." class="search-input" />
      </div>
      <a href="https://github.com" class="github-link" target="_blank" rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
    </div>
  </header>

  <!-- Main Content -->
  <main class="content-main">
    <!-- Hero Section -->
    <section class="hero-section">
      <h1 class="hero-title">Documentation</h1>
      <p class="hero-description">
        Learn how to build, configure, and deploy AI agents with agents.cli.
        Master skills, commands, rules, and hooks to create powerful autonomous systems.
      </p>
    </section>

    <!-- Guide Categories -->
    <section class="categories-section">
      <!-- Getting Started -->
      <div class="category">
        <div class="category-header">
          <span class="category-label">GETTING STARTED</span>
          <h2 class="category-title">Begin Your Journey</h2>
        </div>
        <div class="category-cards">
          <GuideCard
            title="Introduction"
            description="Learn what agents.cli is and how it can transform your AI workflow."
            href="/guides/getting-started"
            icon="book"
          />
          <GuideCard
            title="Installation"
            description="Get up and running with agents.cli in just a few minutes."
            href="/guides/installation"
            icon="download"
          />
          <GuideCard
            title="Quickstart"
            description="Create your first agent and see it in action immediately."
            href="/guides/quickstart"
            icon="rocket"
          />
        </div>
      </div>

      <!-- Core Concepts -->
      <div class="category">
        <div class="category-header">
          <span class="category-label">CORE CONCEPTS</span>
          <h2 class="category-title">Understand the Architecture</h2>
        </div>
        <div class="category-cards">
          <GuideCard
            title="Agent Architecture"
            description="Deep dive into how agents are structured and communicate."
            href="/guides/agent-architecture"
            icon="layers"
          />
          <GuideCard
            title="Memory Management"
            description="Learn how agents maintain context and learn from interactions."
            href="/guides/memory-management"
            icon="database"
          />
          <GuideCard
            title="Orchestration"
            description="Coordinate multiple agents to work together seamlessly."
            href="/guides/orchestration"
            icon="workflow"
          />
        </div>
      </div>

      <!-- Skills & Commands -->
      <div class="category">
        <div class="category-header">
          <span class="category-label">SKILLS & COMMANDS</span>
          <h2 class="category-title">Extend Agent Capabilities</h2>
        </div>
        <div class="category-cards">
          <GuideCard
            title="Writing Skills"
            description="Create reusable skill modules that extend agent capabilities."
            href="/guides/writing-skills"
            icon="puzzle"
          />
          <GuideCard
            title="Custom Commands"
            description="Build slash commands for quick agent interactions."
            href="/guides/custom-commands"
            icon="terminal"
          />
          <GuideCard
            title="Tool Integration"
            description="Connect agents to external APIs and services."
            href="/guides/tool-integration"
            icon="plug"
          />
        </div>
      </div>

      <!-- Rules & Hooks -->
      <div class="category">
        <div class="category-header">
          <span class="category-label">RULES & HOOKS</span>
          <h2 class="category-title">Control Agent Behavior</h2>
        </div>
        <div class="category-cards">
          <GuideCard
            title="Writing Global Rules"
            description="Define universal behavior constraints and safety protocols."
            href="/guides/writing-global-rules"
            icon="shield"
            featured={true}
          />
          <GuideCard
            title="Hooks System"
            description="Trigger automated workflows on agent lifecycle events."
            href="/guides/hooks"
            icon="zap"
          />
          <GuideCard
            title="Context Rules"
            description="Apply conditional rules based on context and state."
            href="/guides/context-rules"
            icon="filter"
          />
        </div>
      </div>

      <!-- MCP Setup -->
      <div class="category">
        <div class="category-header">
          <span class="category-label">MCP SETUP</span>
          <h2 class="category-title">Model Context Protocol</h2>
        </div>
        <div class="category-cards">
          <GuideCard
            title="Server Configuration"
            description="Set up and configure MCP servers for your agents."
            href="/guides/server-config"
            icon="server"
          />
          <GuideCard
            title="Security Contexts"
            description="Implement secure contexts for sensitive operations."
            href="/guides/security-contexts"
            icon="lock"
          />
        </div>
      </div>
    </section>

    <!-- Pro Tip Callout -->
    <section class="pro-tip">
      <div class="pro-tip-icon">
        <svg width="15" height="20" viewBox="0 0 15 20" fill="none">
          <path d="M7.5 0C3.358 0 0 3.358 0 7.5C0 10.5 2 13 5 14.5V18C5 19.1 5.9 20 7 20H8C9.1 20 10 19.1 10 18V14.5C13 13 15 10.5 15 7.5C15 3.358 11.642 0 7.5 0Z" fill="#7c69f7"/>
        </svg>
      </div>
      <div class="pro-tip-content">
        <h4 class="pro-tip-title">Pro Tip</h4>
        <p class="pro-tip-text">
          Use global rules for formatting constraints (e.g., "Always output JSON") instead of repeating them
          in individual agent configs. This reduces token usage across your entire swarm.
        </p>
      </div>
    </section>

    <!-- Footer -->
    <footer class="content-footer">
      <span class="footer-text">Last updated: Mar 8, 2026</span>
      <a href="#" class="footer-link">
        Edit this page
        <svg width="9" height="9" viewBox="0 0 9 9" fill="none">
          <path d="M8 1H5.5V2H6.793L3.146 5.646L3.854 6.354L7.5 2.707V4H8.5V1.5L8 1Z" fill="currentColor"/>
          <path d="M1 2V8H7V5.5H6V7H2V3H3.5V2H1Z" fill="currentColor"/>
        </svg>
      </a>
    </footer>
  </main>
</div>

<style>
  .guides-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow-y: auto;
    scrollbar-width: none; /* Firefox */
  }

  .guides-content::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Edge */
  }

  .content-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 32px;
    background: rgba(10, 10, 15, 0.8);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(124, 105, 247, 0.15);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .breadcrumb-item {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 500;
    font-size: 14px;
    color: #64748b;
  }

  .breadcrumb-item.active {
    color: #7c69f7;
  }

  .breadcrumb-separator {
    width: 4px;
    height: 6px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    color: #6b7280;
    pointer-events: none;
  }

  .search-input {
    width: 256px;
    padding: 8px 16px 8px 40px;
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid #1e293b;
    border-radius: 9999px;
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 14px;
    color: #ffffff;
    outline: none;
    transition: all 0.2s ease;
  }

  .search-input::placeholder {
    color: #6b7280;
  }

  .search-input:focus {
    border-color: #7c69f7;
    background: rgba(15, 23, 42, 0.8);
  }

  .github-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    transition: color 0.2s ease;
  }

  .github-link:hover {
    color: #ffffff;
  }

  .content-main {
    padding: 48px 32px;
    max-width: 1280px;
  }

  /* Hero Section */
  .hero-section {
    margin-bottom: 64px;
  }

  .hero-title {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-weight: 800;
    font-size: 36px;
    color: #ffffff;
    letter-spacing: -0.9px;
    margin-bottom: 16px;
  }

  .hero-description {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 18px;
    color: #94a3b8;
    line-height: 1.625;
    max-width: 640px;
  }

  /* Categories */
  .categories-section {
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  .category {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .category-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .category-label {
    font-family: "Fira Code", monospace;
    font-size: 12px;
    color: #7c69f7;
    text-transform: uppercase;
    letter-spacing: 2.4px;
  }

  .category-title {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 700;
    font-size: 24px;
    color: #f1f5f9;
  }

  .category-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  /* Pro Tip */
  .pro-tip {
    display: flex;
    gap: 16px;
    padding: 25px;
    background: rgba(124, 105, 247, 0.1);
    border: 1px solid rgba(124, 105, 247, 0.2);
    border-radius: 12px;
    margin-top: 64px;
    position: relative;
    overflow: hidden;
  }

  .pro-tip::before {
    content: "";
    position: absolute;
    right: 0;
    top: 0;
    width: 88px;
    height: 87px;
    background: linear-gradient(135deg, rgba(124, 105, 247, 0.2) 0%, transparent 100%);
    border-radius: 0 12px 0 100%;
  }

  .pro-tip-icon {
    flex-shrink: 0;
    padding-top: 2px;
  }

  .pro-tip-content {
    flex: 1;
  }

  .pro-tip-title {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-weight: 700;
    font-size: 14px;
    color: #7c69f7;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    margin-bottom: 4px;
  }

  .pro-tip-text {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 14px;
    color: #cbd5e1;
    line-height: 1.625;
  }

  /* Footer */
  .content-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 32px;
    margin-top: 80px;
    border-top: 1px solid rgba(124, 105, 247, 0.15);
  }

  .footer-text {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 14px;
    color: #64748b;
  }

  .footer-link {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 14px;
    color: #64748b;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: #7c69f7;
  }

  @media (max-width: 768px) {
    .content-header {
      padding: 16px;
      flex-direction: column;
      gap: 16px;
      align-items: stretch;
    }

    .search-input {
      width: 100%;
    }

    .content-main {
      padding: 32px 16px;
    }

    .hero-title {
      font-size: 28px;
    }

    .hero-description {
      font-size: 16px;
    }

    .category-cards {
      grid-template-columns: 1fr;
    }

    .content-footer {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }
</style>
