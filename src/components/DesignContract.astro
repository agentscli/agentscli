---
/**
 * Emits a direction-contract comment into the built HTML. MDX cannot carry
 * raw HTML comments, so pages import this once, at the top of their body.
 * The contract must survive the production build - verify by grepping dist/
 * for the contract key after building.
 */
interface Props {
  text: string;
}
const { text } = Astro.props;
const safe = text.replace(/--+/g, '—').replace(/</g, '(').replace(/>/g, ')');
---
<Fragment set:html={`<!--\n${safe}\n-->`} />
