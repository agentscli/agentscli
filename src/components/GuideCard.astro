---
// Guide Card Component
interface Props {
  title: string;
  description: string;
  href: string;
  icon?: "book" | "download" | "rocket" | "layers" | "database" | "workflow" | "puzzle" | "terminal" | "plug" | "shield" | "zap" | "filter" | "server" | "lock" | "code";
  featured?: boolean;
}

const { title, description, href, icon = "book", featured = false } = Astro.props;

const icons: Record<string, string> = {
  book: `<path d="M4 0C2.895 0 2 0.895 2 2V14C2 15.105 2.895 16 4 16H14C15.105 16 16 15.105 16 14V2C16 0.895 15.105 0 14 0H4ZM4 2H14V14H4V2ZM6 4V6H12V4H6ZM6 8V10H12V8H6Z" fill="currentColor"/>`,
  download: `<path d="M8 0L6 2H2V4H6L8 6L10 4H14V2H10L8 0ZM8 8L4 12H6V16H10V12H12L8 8Z" fill="currentColor"/>`,
  rocket: `<path d="M8 0C5.79 0 4 1.79 4 4V8L2 10V12H6V16H10V12H14V10L12 8V4C12 1.79 10.21 0 8 0ZM8 2C9.1 2 10 2.9 10 4V6H6V4C6 2.9 6.9 2 8 2Z" fill="currentColor"/>`,
  layers: `<path d="M8 0L0 4.5V11.5L8 16L16 11.5V4.5L8 0ZM8 2.5L13 5.5L8 8.5L3 5.5L8 2.5ZM2 7L7 9.5V13L2 10.5V7ZM9 13V9.5L14 7V10.5L9 13Z" fill="currentColor"/>`,
  database: `<ellipse cx="8" cy="4" rx="6" ry="3" fill="currentColor"/><path d="M2 4V12C2 13.657 4.686 15 8 15C11.314 15 14 13.657 14 12V4C14 5.657 11.314 7 8 7C4.686 7 2 5.657 2 4ZM2 7.5C2 9.157 4.686 10.5 8 10.5C11.314 10.5 14 9.157 14 7.5V10C14 11.657 11.314 13 8 13C4.686 13 2 11.657 2 10V7.5Z" fill="currentColor"/>`,
  workflow: `<path d="M2 2H6V6H2V2ZM10 2H14V6H10V2ZM2 10H6V14H2V10ZM10 10H14V14H10V10ZM6 3H10V4H6V3ZM3 6V10H4V6H3ZM12 6V10H13V6H12ZM6 12H10V13H6V12Z" fill="currentColor"/>`,
  puzzle: `<path d="M6 0C4.895 0 4 0.895 4 2H2C0.895 2 0 2.895 0 4V6C1.105 6 2 6.895 2 8C2 9.105 1.105 10 0 10V12C0 13.105 0.895 14 2 14H4C4 15.105 4.895 16 6 16C7.105 16 8 15.105 8 14H10C11.105 14 12 13.105 12 12V10C13.105 10 14 9.105 14 8C14 6.895 13.105 6 12 6V4C12 2.895 11.105 2 10 2H8C8 0.895 7.105 0 6 0Z" fill="currentColor"/>`,
  terminal: `<path d="M2 2C0.895 2 0 2.895 0 4V12C0 13.105 0.895 14 2 14H14C15.105 14 16 13.105 16 12V4C16 2.895 15.105 2 14 2H2ZM4 5L7 8L4 11L5 12L9 8L5 4L4 5ZM10 10H14V12H10V10Z" fill="currentColor"/>`,
  plug: `<path d="M11 0V3H12V0H14V3H15V6L13 8V10L6 17L3 14L10 7H12L14 5H2V3H4V0H6V3H10V0H11Z" fill="currentColor"/>`,
  shield: `<path d="M8 0L2 2V7.5C2 12.15 4.55 14.85 8 16C11.45 14.85 14 12.15 14 7.5V2L8 0ZM8 2L12 3.5V7.5C12 10.85 10.2 12.75 8 13.85C5.8 12.75 4 10.85 4 7.5V3.5L8 2Z" fill="currentColor"/>`,
  zap: `<path d="M9 0L3 9H7L5 16L13 6H9L11 0H9Z" fill="currentColor"/>`,
  filter: `<path d="M0 2H16V4H0V2ZM2 6H14V8H2V6ZM4 10H12V12H4V10ZM6 14H10V16H6V14Z" fill="currentColor"/>`,
  server: `<rect x="1" y="2" width="14" height="4" rx="1" fill="currentColor"/><rect x="1" y="8" width="14" height="4" rx="1" fill="currentColor"/><circle cx="4" cy="4" r="1" fill="var(--ac-accent-tint)"/><circle cx="4" cy="10" r="1" fill="var(--ac-accent-tint)"/>`,
  lock: `<path d="M12 7V5C12 2.79 10.21 1 8 1C5.79 1 4 2.79 4 5V7H3V15H13V7H12ZM6 5C6 3.9 6.9 3 8 3C9.1 3 10 3.9 10 5V7H6V5Z" fill="currentColor"/>`,
  code: `<path d="M5 4L1 8L5 12L6 11L3 8L6 5L5 4ZM11 4L10 5L13 8L10 11L11 12L15 8L11 4Z" fill="currentColor"/>`,
};
---

<a href={href} class:list={["guide-card", { featured }]}>
  <div class="card-header">
    <div class="card-icon">
      <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" set:html={icons[icon]} />
    </div>
    <svg class="card-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M2 6H10M10 6L6 2M10 6L6 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
  <div class="card-content">
    <h3 class="card-title">{title}</h3>
    <p class="card-description">{description}</p>
  </div>
  {featured && <span class="featured-badge">Featured</span>}
</a>

<style>
  .guide-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    background: var(--ac-surface);
    border: 1px solid var(--sl-color-accent-low);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .guide-card:hover {
    background: var(--ac-surface-hover);
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
  }

  .guide-card:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .guide-card.featured {
    background: linear-gradient(135deg, var(--ac-accent-tint) 0%, var(--ac-surface) 100%);
    border-color: var(--sl-color-accent-low);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 60px;
  }

  .card-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ac-accent-tint);
    border-radius: 8px;
    color: var(--sl-color-accent);
  }

  .card-arrow {
    color: var(--sl-color-gray-2);
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.2s ease;
  }

  .guide-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .card-content {
    flex: 1;
  }

  .card-title {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: var(--sl-color-white);
    margin-bottom: 8px;
  }

  .card-description {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 14px;
    color: var(--sl-color-gray-2);
    line-height: 1.5;
    margin: 0;
  }

  .featured-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 4px 8px;
    background: var(--ac-accent-tint);
    border-radius: 4px;
    font-family: "Fira Code", monospace;
    font-size: 10px;
    color: var(--sl-color-text-accent);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
</style>
