---
// Blog Header Component - Figma Design
interface Props {
  currentPath?: string;
}

const { currentPath = "/blog" } = Astro.props;

// Determine which nav item is active
const isActive = (path: string) => {
  if (path === "/blog") return currentPath.startsWith("/blog");
  return currentPath.startsWith(path);
};
---

<header class="blog-header">
  <div class="header-left">
    <a href="/" class="header-brand">
      <img src="/logo-dark.svg" alt="agents.cli logo" class="header-logo-icon logo-dark" />
      <img src="/logo-light.png" alt="agents.cli logo" class="header-logo-icon logo-light" />
    </a>
    <nav class="header-nav">
      <a href="/foundations/" class:list={["nav-link", { active: isActive("/foundations") }]} data-track="nav-foundations">Foundations</a>
      <a href="/blog" class:list={["nav-link", { active: isActive("/blog") }]} data-track="nav-blog">Blog</a>
      <a href="https://github.com/agentscli" class="nav-link" target="_blank" rel="noopener noreferrer" data-track="nav-github">GitHub</a>
    </nav>
  </div>
  <div class="header-right">
    <div class="search-container">
      <div class="search-icon">
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M10.5 10.5L14 14M6.5 11.5C3.18629 11.5 0.5 8.81371 0.5 5.5C0.5 2.18629 3.18629 -0.5 6.5 -0.5C9.81371 -0.5 12.5 2.18629 12.5 5.5C12.5 8.81371 9.81371 11.5 6.5 11.5Z" stroke="#64748b" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <input type="search" name="q" aria-label="Search blog posts" placeholder="Search insights..." class="search-input" />
    </div>
    <button class="subscribe-btn" data-track="subscribe-btn">Subscribe</button>
  </div>
</header>

<style>
  .blog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 80px 25px;
    background: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(2px);
    position: relative;
    z-index: 10;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .header-logo-icon {
    width: 128px;
    height: 32px;
    object-fit: contain;
  }

  /* Default (dark mode): show dark logo, hide light */
  .logo-light { display: none; }
  .logo-dark { display: block; }

  /* Light theme: show light logo, hide dark */
  :global(:root[data-theme="light"]) .logo-light { display: block; }
  :global(:root[data-theme="light"]) .logo-dark { display: none; }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-left: 8px;
  }

  .nav-link {
    font-family: "Fira Code", "SF Mono", Monaco, monospace;
    font-size: 14px;
    font-weight: 500;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-link.active {
    color: #7c69f7;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .search-container {
    display: flex;
    align-items: center;
    min-width: 160px;
    max-width: 256px;
    width: 231px;
    height: 40px;
    background: #111118;
    border: 1px solid #1e1e26;
    border-radius: 8px;
    padding-left: 12px;
    gap: 8px;
  }

  .search-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    height: 100%;
    background: transparent;
    border: none;
    outline: none;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 14px;
    color: #f1f5f9;
    padding-right: 12px;
  }

  .search-input::placeholder {
    color: #64748b;
  }

  .subscribe-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0 24px;
    background: #7c69f7;
    border: none;
    border-radius: 8px;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .subscribe-btn:hover {
    background: #6b58e6;
  }

  @media (max-width: 1200px) {
    .blog-header {
      padding: 16px 40px 17px;
    }

    .search-container {
      width: 180px;
      max-width: 200px;
    }
  }

  @media (max-width: 768px) {
    .blog-header {
      padding: 16px 24px 17px;
      flex-direction: column;
      gap: 16px;
    }

    .header-left {
      width: 100%;
      justify-content: space-between;
    }

    .header-right {
      width: 100%;
    }

    .search-container {
      flex: 1;
      max-width: none;
    }

    .header-nav {
      gap: 16px;
    }
  }
</style>
