---
// Guides Table of Contents (Right Sidebar)
---

<aside class="guides-toc">
  <div class="toc-container">
    <h5 class="toc-heading">On this page</h5>
    <nav class="toc-nav">
      <ul class="toc-list">
        <li class="toc-item active">
          <a href="#getting-started" class="toc-link">Getting Started</a>
        </li>
        <li class="toc-item">
          <a href="#core-concepts" class="toc-link">Core Concepts</a>
        </li>
        <li class="toc-item">
          <a href="#skills-commands" class="toc-link">Skills & Commands</a>
        </li>
        <li class="toc-item">
          <a href="#rules-hooks" class="toc-link">Rules & Hooks</a>
        </li>
        <li class="toc-item">
          <a href="#mcp-setup" class="toc-link">MCP Setup</a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="toc-help">
    <h6 class="help-heading">Need help?</h6>
    <p class="help-text">
      Join our Discord community to get support from other agent developers.
    </p>
    <a href="https://discord.gg/agentscli" class="help-button" target="_blank" rel="noopener">
      Join Discord
    </a>
  </div>
</aside>

<style>
  .guides-toc {
    width: 256px;
    min-width: 256px;
    height: 100%;
    padding: 48px 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
    overflow-y: auto;
    scrollbar-width: none; /* Firefox */
  }

  .guides-toc::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Edge */
  }

  .toc-container {
    padding-left: 16px;
  }

  .toc-heading {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 700;
    font-size: 12px;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin-bottom: 16px;
  }

  .toc-nav {
    border-left: 1px solid rgba(124, 105, 247, 0.15);
    padding-left: 17px;
  }

  .toc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .toc-link {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 14px;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
    display: block;
  }

  .toc-link:hover {
    color: #cbd5e1;
  }

  .toc-item.active .toc-link {
    color: #7c69f7;
    font-weight: 500;
  }

  .toc-help {
    margin-left: 16px;
    padding: 24px;
    background: linear-gradient(146deg, rgb(15, 23, 42) 0%, rgb(30, 41, 59) 100%);
    border: 1px solid rgba(124, 105, 247, 0.15);
    border-radius: 12px;
  }

  .help-heading {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 700;
    font-size: 12px;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .help-text {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 12px;
    color: #94a3b8;
    line-height: 1.33;
    margin-bottom: 16px;
  }

  .help-button {
    display: block;
    width: 100%;
    padding: 8px 16px;
    background: #7c69f7;
    border: none;
    border-radius: 8px;
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 700;
    font-size: 12px;
    color: #ffffff;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 10px 15px -3px rgba(124, 105, 247, 0.2);
    transition: all 0.2s ease;
  }

  .help-button:hover {
    background: #6b58e6;
    box-shadow: 0 10px 20px -3px rgba(124, 105, 247, 0.3);
  }

  @media (max-width: 1400px) {
    .guides-toc {
      width: 220px;
      min-width: 220px;
    }
  }
</style>
