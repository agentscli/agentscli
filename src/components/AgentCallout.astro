---
// Agent Callout Component - For highlighted notes/tips in blog posts
interface Props {
  title?: string;
  icon?: "note" | "tip" | "warning" | "info";
}

const {
  title = "Agent Note",
  icon = "note"
} = Astro.props;
---

<div class="agent-callout">
  <div class="callout-header">
    <div class="callout-icon">
      {icon === "note" && (
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M11 1a10 10 0 100 20 10 10 0 000-20zm1 15H9.5v-2H12v2zm0-4H9.5V6H12v6z" fill="#7c69f7"/>
        </svg>
      )}
      {icon === "tip" && (
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M11 1a10 10 0 100 20 10 10 0 000-20zm1.5 14.5h-3v-3h3v3zm0-5h-3v-5h3v5z" fill="#4ade80"/>
        </svg>
      )}
      {icon === "warning" && (
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M11 1L1 19h20L11 1zm0 14a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm1-5H9.5V6H12v4z" fill="#facc15"/>
        </svg>
      )}
      {icon === "info" && (
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M11 1a10 10 0 100 20 10 10 0 000-20zm1 15H9.5v-7H12v7zm0-9H9.5V5H12v2z" fill="#7c69f7"/>
        </svg>
      )}
    </div>
    <h4 class="callout-title">{title}</h4>
  </div>
  <div class="callout-content">
    <slot />
  </div>
</div>

<style>
  .agent-callout {
    background: rgba(124, 105, 247, 0.05);
    border-left: 4px solid #7c69f7;
    border-radius: 12px;
    padding: 32px 32px 56px 36px;
    margin: 56px 0;
  }

  .callout-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .callout-icon {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .callout-icon svg {
    width: 100%;
    height: 100%;
  }

  .callout-title {
    font-family: 'Plus Jakarta Sans', 'Space Grotesk', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    margin: 0;
  }

  .callout-content {
    font-family: 'Plus Jakarta Sans', 'Space Grotesk', system-ui, sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 31.5px;
    color: #e8e8f0;
  }

  .callout-content :global(p) {
    margin: 0;
  }

  .callout-content :global(p + p) {
    margin-top: 16px;
  }
</style>
