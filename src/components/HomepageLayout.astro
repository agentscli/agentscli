---
// Homepage Layout Component
import Header from "./Header.astro";
import Footer from "./Footer.astro";
// Custom (non-Starlight) layout: import the theme-aware token layer so the
// chrome here has access to --sl-* / --ac-* tokens that flip light <-> dark.
import "../styles/theme.css";

interface Props {
  title?: string;
}

const { title = "agents.cli" } = Astro.props;
---

<div class="homepage-container">
  <div class="grid-background"></div>
  <div class="grid-gradient"></div>
  <Header />
  <main class="homepage-main">
    <slot />
  </main>
  <Footer />
</div>

<style>
  .homepage-container {
    background-color: var(--sl-color-bg);
    color: var(--sl-color-text);
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
  }

  .grid-background {
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(90deg, var(--ac-grid-line) 2.5%, transparent 2.5%),
      linear-gradient(180deg, var(--ac-grid-line) 2.5%, transparent 2.5%);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .grid-gradient {
    position: fixed;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      color-mix(in srgb, var(--sl-color-bg) 50%, transparent) 50%,
      var(--sl-color-bg) 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  .homepage-main {
    position: relative;
    z-index: 1;
  }
</style>
