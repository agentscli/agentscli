---
// Header Component
---

<header class="homepage-header">
  <a href="/" class="header-logo" aria-label="agents.cli - home">
    <img
      src="/logo-dark.svg"
      alt="agents.cli logo"
      class="header-logo-icon logo-dark"
    />
    <img
      src="/logo-light.svg"
      alt="agents.cli logo"
      class="header-logo-icon logo-light"
    />
  </a>
  <nav class="header-nav">
    <a href="/foundations" class="nav-link">Foundations</a>
    <a href="/blog" class="nav-link">Blog</a>
    <a href="https://github.com/agentscli" class="nav-link">GitHub</a>
    <div class="nav-divider"></div>
    <a href="https://github.com/agentscli" class="nav-button">
      <svg
        class="nav-button-icon"
        width="12"
        height="12"
        viewBox="0 0 12 12"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M6 .5a5.5 5.5 0 0 0-1.74 10.72c.275.05.374-.118.374-.264v-.918c-1.529.332-1.85-.731-1.85-.731-.25-.635-.61-.804-.61-.804-.499-.34.038-.334.038-.334.55.038.84.564.84.564.489.837 1.283.595 1.596.454.05-.355.191-.596.348-.733-1.218-.124-2.5-.609-2.5-2.708 0-.598.214-1.087.564-1.47-.056-.138-.244-.695.054-1.45 0 0 .46-.147 1.506.562.437-.122.906-.182 1.372-.184.466.002.935.062 1.373.184 1.045-.709 1.504-.562 1.504-.562.299.755.111 1.312.055 1.45.35.383.563.872.563 1.47 0 2.107-1.285 2.582-2.507 2.717.197.17.372.506.372 1.02v1.51c0 .146.098.316.376.262A5.501 5.501 0 0 0 6 .5z"
          fill="currentColor"></path>
      </svg>
      <span>Star on GitHub</span>
    </a>
  </nav>
</header>

<style>
  .homepage-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 80px 25px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(2px);
    position: relative;
    z-index: 10;
  }

  .header-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .header-logo:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .header-logo-icon {
    width: 128px;
    height: 32px;
    object-fit: contain;
  }

  /* Default (dark mode): show dark logo, hide light */
  .logo-light {
    display: none;
  }
  .logo-dark {
    display: block;
  }

  /* Light theme: show light logo, hide dark */
  :global(:root[data-theme="light"]) .logo-light {
    display: block;
  }
  :global(:root[data-theme="light"]) .logo-dark {
    display: none;
  }

  .header-logo-text {
    font-family: "Fira Code", "SF Mono", Monaco, monospace;
    font-size: 18px;
    font-weight: 500;
    color: #ffffff;
    letter-spacing: -0.9px;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .nav-link {
    font-family: "Fira Code", "SF Mono", Monaco, monospace;
    font-size: 14px;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-divider {
    width: 1px;
    height: 16px;
    background: rgba(255, 255, 255, 0.1);
  }

  .nav-button {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 13px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    font-family: "Fira Code", "SF Mono", Monaco, monospace;
    font-size: 12px;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .nav-button:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  .nav-button-icon {
    width: 11.667px;
    height: 11.083px;
  }

  @media (max-width: 768px) {
    .homepage-header {
      padding: 20px 24px;
      flex-direction: column;
      gap: 20px;
    }

    .header-nav {
      gap: 24px;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
