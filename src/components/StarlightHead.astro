---
// Starlight <Head> override. It wraps the default head and adds one thing:
// a `data-surface="course"` marker on <html> for every route under /course/.
//
// The course is the one Starlight surface that reads as a book rather than as
// a spec, so theme.css gives it a narrower column, a sans heading face, and a
// hairline above each section. Foundations must not inherit any of that, so
// the register is gated on this attribute rather than applied globally.
//
// <html> is owned by Starlight's own route, not by any overridable component,
// so the attribute is set from an inline script in the head. The script runs
// while the head parses, before the body paints, so there is no flash. With
// JavaScript off the page falls back to the default typography, which is a
// readable page either way.
import Default from '@astrojs/starlight/components/Head.astro';

const route = Astro.locals.starlightRoute;
const id = route.id;
const isCourse = id === 'course' || id.startsWith('course/');
---

<Default><slot /></Default>
{isCourse && <script is:inline>document.documentElement.dataset.surface = 'course';</script>}
