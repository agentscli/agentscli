---
// Custom topic switcher for starlight-sidebar-topics.
//
// The plugin renders topics as a flat list. We want the two course topics
// (Claude Code, Codex) to read as children nested under the "Courses" parent,
// while every other topic (Foundations, …) stays a top-level row. Grouping is
// data-driven: a topic whose link sits *below* the Courses hub link
// (`/course/…`) is treated as a child; the hub itself (`/course/`) is the
// parent; anything else is a standalone top-level topic.
//
// Reads the documented `Astro.locals.starlightSidebarTopics` data, so it stays
// in sync with the config-defined topics. See the plugin's custom-topic-list
// guide.
import { Badge, Icon } from '@astrojs/starlight/components';
import type { ComponentProps } from 'astro/types';

type Topic = {
	link: string;
	label: string;
	isCurrent: boolean;
	icon?: ComponentProps<typeof Icon>['name'];
	badge?: {
		text: string;
		variant: 'note' | 'danger' | 'success' | 'caution' | 'tip' | 'default';
	};
};

const { topics } = Astro.locals.starlightSidebarTopics as { topics: Topic[] };

const COURSE_HUB = '/course/';

const normalize = (link: string) => (link.endsWith('/') ? link : `${link}/`);

const isHub = (t: Topic) => normalize(t.link) === COURSE_HUB;
const isCourseChild = (t: Topic) => normalize(t.link).startsWith(COURSE_HUB) && !isHub(t);

const courseChildren = topics.filter(isCourseChild);
const topLevel = topics.filter((t) => !isCourseChild(t));

// Bespoke glyphs for the two top-level topics. Starlight's built-in icon set
// has no graduation-cap or foundation/layers glyph, so we render inline SVGs
// keyed by normalized topic link. Solid-fill paths, sized 1em, so the
// `fill: currentColor` rule below drives them (the active state inverts to the
// accent background, same as the built-in icons). Any topic without a custom
// glyph falls back to its config-defined `icon`.
const CUSTOM_ICONS: Record<string, string> = {
	// Courses - mortarboard / graduation cap.
	'/course/':
		'<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true"><path d="M12 3 1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z"/></svg>',
	// Foundations - stacked layers.
	'/foundations/':
		'<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true"><path d="M11.99 18.54 4.62 12.81 3 14.07l9 7 9-7-1.63-1.27zM12 16l7.36-5.73L21 9l-9-7-9 7 1.63 1.27zM12 4.53 18.14 9 12 13.47 5.86 9z"/></svg>',
};

const customIconFor = (t: Topic) => CUSTOM_ICONS[normalize(t.link)];
---

<ul class="starlight-sidebar-topics">
	{
		topLevel.map((topic) => {
			const customIcon = customIconFor(topic);
			return (
			<li>
				<a
					href={topic.link}
					class:list={{ 'starlight-sidebar-topics-current': topic.isCurrent }}
				>
					{customIcon ? (
						<div class="starlight-sidebar-topics-icon" set:html={customIcon} />
					) : topic.icon ? (
						<div class="starlight-sidebar-topics-icon">
							<Icon name={topic.icon} />
						</div>
					) : null}
					<div>
						{topic.label}
						{topic.badge && (
							<Badge
								class="starlight-sidebar-topics-badge"
								text={topic.badge.text}
								variant={topic.badge.variant}
							/>
						)}
					</div>
				</a>

				{isHub(topic) && courseChildren.length > 0 && (
					<ul class="starlight-sidebar-topics-children">
						{courseChildren.map((child) => (
							<li>
								<a
									href={child.link}
									class:list={{
										'starlight-sidebar-topics-current': child.isCurrent,
									}}
								>
									<div>
										{child.label}
										{child.badge && (
											<Badge
												class="starlight-sidebar-topics-badge"
												text={child.badge.text}
												variant={child.badge.variant}
											/>
										)}
									</div>
								</a>
							</li>
						))}
					</ul>
				)}
			</li>
			);
		})
	}
</ul>

<style>
	ul {
		list-style: none;
		padding: 0;
	}

	.starlight-sidebar-topics::after {
		content: '';
		display: block;
		margin-top: 1rem;
		height: 1px;
		border-top: 1px solid var(--sl-color-hairline-light);
	}

	li {
		overflow-wrap: anywhere;
	}

	.starlight-sidebar-topics > li + li {
		margin-top: 0.25rem;
	}

	a {
		align-items: center;
		color: var(--sl-color-white);
		display: flex;
		font-size: var(--sl-text-base);
		font-weight: 600;
		gap: 0.5rem;
		line-height: 1.5;
		padding: 0.3em 0.5rem;
		text-decoration: none;
	}

	a:is(.starlight-sidebar-topics-current, :hover, :focus-visible) {
		color: var(--sl-color-accent-high);
	}

	:global([data-theme='light']) a.starlight-sidebar-topics-current {
		color: var(--sl-color-accent);
	}

	.starlight-sidebar-topics-icon {
		align-items: center;
		border-radius: 0.25rem;
		border: 1px solid var(--sl-color-gray-4);
		display: flex;
		justify-content: center;
		padding: 0.25rem;
	}

	/* Drive the glyph fill through CSS `currentColor` rather than relying on
	   the svg's `fill="currentColor"` presentation attribute. Chrome can fail
	   to repaint attribute-driven inline SVG fills when only an ancestor's
	   color/theme changes (the topic icons would blank out on theme toggle);
	   a CSS fill rule is part of the cascade and repaints reliably. */
	.starlight-sidebar-topics-icon :global(svg),
	.starlight-sidebar-topics-icon :global(svg path) {
		fill: currentColor;
	}

	a:is(.starlight-sidebar-topics-current, :hover, :focus-visible)
		.starlight-sidebar-topics-icon {
		background-color: var(--sl-color-text-accent);
		border-color: var(--sl-color-text-accent);
		color: var(--sl-color-text-invert);
	}

	.starlight-sidebar-topics-badge {
		margin-inline-start: 0.25em;
	}

	/* Nested course topics: indented under the Courses parent, lighter weight. */
	.starlight-sidebar-topics-children {
		margin-top: 0.25rem;
		/* align children under the parent label, past the icon box */
		margin-inline-start: 0.85rem;
		padding-inline-start: 0.6rem;
		border-inline-start: 1px solid var(--sl-color-hairline-light);
	}

	.starlight-sidebar-topics-children li + li {
		margin-top: 0.125rem;
	}

	.starlight-sidebar-topics-children a {
		font-weight: 500;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-1);
	}

	.starlight-sidebar-topics-children
		a:is(.starlight-sidebar-topics-current, :hover, :focus-visible) {
		color: var(--sl-color-accent-high);
	}
</style>
