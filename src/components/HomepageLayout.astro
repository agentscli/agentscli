---
// Homepage Layout Component
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props {
  title?: string;
}

const { title = "agents.cli" } = Astro.props;
---

<div class="homepage-container">
  <div class="grid-background"></div>
  <div class="grid-gradient"></div>
  <Header />
  <main class="homepage-main">
    <slot />
  </main>
  <Footer />
</div>

<style>
  .homepage-container {
    background-color: #0a0910;
    color: #ffffff;
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
  }

  .grid-background {
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(
        90deg,
        rgba(124, 105, 247, 0.05) 2.5%,
        rgba(124, 105, 247, 0) 2.5%
      ),
      linear-gradient(
        180deg,
        rgba(124, 105, 247, 0.05) 2.5%,
        rgba(124, 105, 247, 0) 2.5%
      );
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .grid-gradient {
    position: fixed;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10, 9, 16, 0) 0%,
      rgba(10, 9, 16, 0.5) 50%,
      #0a0910 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  .homepage-main {
    position: relative;
    z-index: 1;
  }
</style>
