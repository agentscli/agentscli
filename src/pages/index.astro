---
// Homepage - agents.cli
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FeatureCard from "../components/FeatureCard.astro";
import GapDemo from "../components/interactive/GapDemo.tsx";
import LoopStepper from "../components/interactive/LoopStepper.tsx";
import ConfigExplorer from "../components/interactive/ConfigExplorer.tsx";
import PrimitivePicker from "../components/interactive/PrimitivePicker.tsx";
import "../styles/widget-standalone.css";
---

<!doctype html>
<!-- Homepage is pinned to the dark brand identity; it does not honor the
     light/dark toggle. data-theme here covers the no-JS case; <Head pinTheme>
     enforces it over stored/OS preference when JS runs. -->
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="A publication on context engineering, closing the gap between AI coding agents and the context they don't have."
    />
    <title>agents.cli</title>
    <link rel="canonical" href="https://www.agentscli.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="agents.cli" />
    <meta property="og:title" content="agents.cli" />
    <meta
      property="og:description"
      content="A publication on context engineering, closing the gap between AI coding agents and the context they don't have."
    />
    <meta property="og:url" content="https://www.agentscli.com/" />
    <meta property="og:image" content="https://www.agentscli.com/og-default.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="agents.cli" />
    <meta
      name="twitter:description"
      content="A publication on context engineering, closing the gap between AI coding agents and the context they don't have."
    />
    <meta name="twitter:image" content="https://www.agentscli.com/og-default.png" />
    <Head pinTheme="dark" />
  </head>
  <body>
    <div class="homepage-container">
      <div class="grid-background"></div>
      <div class="grid-gradient"></div>
      <Header />
      <main class="homepage-main">
        <!-- Hero Section -->
        <section class="hero-section">
          <!-- Eyebrow -->
          <div class="announcement-badge">
            <span class="announcement-dot"></span>
            <span class="announcement-text"
              >A publication on context engineering</span
            >
          </div>

          <!-- Main Title -->
          <h1 class="hero-title">agents.cli</h1>

          <!-- Subtitle -->
          <p class="hero-subtitle">
            "Agents are capable.<br />
            They're just missing your context."
          </p>

          <!-- CTA Buttons -->
          <div class="hero-buttons">
            <a href="/course/" class="btn-primary">
              <span>Start a course</span>
              <svg
                class="btn-primary-icon"
                width="10"
                height="10"
                viewBox="0 0 10 10"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M5 0.833252L4.0625 1.77075L7.02083 4.72909H0.833328V5.93742H7.02083L4.0625 8.89575L5 9.83325L9.16666 5.33325L5 0.833252Z"
                  fill="currentColor"></path>
              </svg>
            </a>
            <a href="/foundations/" class="btn-secondary">
              <span>Read the foundations</span>
            </a>
          </div>
        </section>

        <!-- Gap Demo Section -->
        <section class="loop-section">
          <div class="loop-container">
            <p class="loop-label">The thesis, live</p>
            <h2 class="loop-title">Same agent. Same task. Different context.</h2>
            <p class="loop-subtitle">
              Watch one agent run the same request twice — once bare, once with
              the project's context mounted. Flip the switch yourself.
              Everything on this site is about that difference.
            </p>
            <div class="ac-widget-standalone">
              <GapDemo client:visible />
            </div>
            <a class="loop-link" href="/foundations/">
              <span>Start closing the gap: the foundations</span>
              <svg
                width="10"
                height="10"
                viewBox="0 0 10 10"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M5 0.833252L4.0625 1.77075L7.02083 4.72909H0.833328V5.93742H7.02083L4.0625 8.89575L5 9.83325L9.16666 5.33325L5 0.833252Z"
                  fill="currentColor"></path>
              </svg>
            </a>
          </div>
        </section>

        <!-- Explore Section: alternating widget rows -->
        <section class="explore-section">
          <div class="explore-container">
            <header class="explore-header">
              <h2 class="explore-heading">Don't read about it. Operate it.</h2>
              <p class="explore-sub">
                Every core idea on this site ships as something you can poke.
                Three of them, live on this page.
              </p>
            </header>

            <div class="explore-row">
              <div class="explore-copy">
                <h3 class="explore-row-title">Every agent is the same loop.</h3>
                <p class="explore-row-desc">
                  Claude Code, Codex, Copilot, Cursor — under the branding they
                  all run one loop: gather context, act with tools, verify the
                  result. Step through a real bug fix and watch it turn. Once
                  you see the loop, context engineering is just feeding it
                  better.
                </p>
                <a class="explore-row-link" href="/foundations/how-agents-work/">
                  <span>How agents work</span>
                  <svg
                    width="10"
                    height="10"
                    viewBox="0 0 10 10"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M5 0.833252L4.0625 1.77075L7.02083 4.72909H0.833328V5.93742H7.02083L4.0625 8.89575L5 9.83325L9.16666 5.33325L5 0.833252Z"
                      fill="currentColor"></path>
                  </svg>
                </a>
              </div>
              <div class="explore-widget ac-widget-standalone">
                <LoopStepper client:visible />
              </div>
            </div>

            <div class="explore-row explore-row-flip explore-row-wide">
              <div class="explore-copy">
                <h3 class="explore-row-title">Know where every file lives.</h3>
                <p class="explore-row-desc">
                  CLAUDE.md or AGENTS.md? Committed or gitignored? Where do
                  skills, slash commands, and hooks actually go? Browse the
                  real config tree for each tool — every entry says what it
                  does, when it loads, and whether it belongs in git.
                </p>
                <a class="explore-row-link" href="/foundations/configuration/">
                  <span>The configuration chapter</span>
                  <svg
                    width="10"
                    height="10"
                    viewBox="0 0 10 10"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M5 0.833252L4.0625 1.77075L7.02083 4.72909H0.833328V5.93742H7.02083L4.0625 8.89575L5 9.83325L9.16666 5.33325L5 0.833252Z"
                      fill="currentColor"></path>
                  </svg>
                </a>
              </div>
              <div class="explore-widget ac-widget-standalone">
                <ConfigExplorer client:visible />
              </div>
            </div>

            <div class="explore-row">
              <div class="explore-copy">
                <h3 class="explore-row-title">
                  Say the problem. Get the primitive.
                </h3>
                <p class="explore-row-desc">
                  Thirteen primitives close the gap — rules, skills, subagents,
                  MCP, hooks, plan mode, and the rest. You don't need all of
                  them on day one. Pick the sentence that sounds like your
                  problem and it routes you to the chapter built for it.
                </p>
                <a class="explore-row-link" href="/foundations/">
                  <span>All thirteen foundations</span>
                  <svg
                    width="10"
                    height="10"
                    viewBox="0 0 10 10"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M5 0.833252L4.0625 1.77075L7.02083 4.72909H0.833328V5.93742H7.02083L4.0625 8.89575L5 9.83325L9.16666 5.33325L5 0.833252Z"
                      fill="currentColor"></path>
                  </svg>
                </a>
              </div>
              <div class="explore-widget ac-widget-standalone">
                <PrimitivePicker client:visible />
              </div>
            </div>
          </div>
        </section>

        <!-- Features Section -->
        <section class="features-section">
          <div class="features-container">
            <div class="features-header">
              <h2 class="features-title">Three surfaces. One thesis.</h2>
              <p class="features-subtitle">
                Agents are broad, fast, and contextless. The humans they work
                with are the inverse: slower and narrower, but rich in context.
                Everything on this site is about closing that gap.
              </p>
            </div>
            <div class="features-grid">
              <a href="/course/" class="feature-card-link feature-card-wide">
                <FeatureCard
                  title="The courses"
                  description="Learn by doing, one agent at a time. Pick Claude Code or Codex and<br />take a real project across a week of work — from your first change to<br />running it headless in CI. Each lesson is a real problem and the move that fixes it."
                  icon="comparison"
                />
              </a>
              <a href="/foundations/" class="feature-card-link">
                <FeatureCard
                  title="Foundations"
                  description="Thirteen techniques for closing the agent–context gap. Rules, subagents, skills, MCP, hooks, plan mode, permissions, and the rest of the toolkit."
                  icon="rules"
                  variant="primary"
                />
              </a>
              <a href="/blog" class="feature-card-link">
                <FeatureCard
                  title="Blog"
                  description="Essays on how teams actually work with AI coding agents: what compounds, what doesn't, and what's still unsettled."
                  icon="skills"
                  variant="secondary"
                />
              </a>
            </div>
          </div>
        </section>
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: "Space Grotesk", system-ui, sans-serif;
  }

  body {
    background-color: #0d0c12;
    color: #ffffff;
    min-height: 100vh;
  }
</style>

<style>
  .homepage-container {
    background-color: #0d0c12;
    color: #ffffff;
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
  }

  .grid-background {
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(
        90deg,
        rgba(139, 92, 246, 0.05) 2.5%,
        rgba(139, 92, 246, 0) 2.5%
      ),
      linear-gradient(
        180deg,
        rgba(139, 92, 246, 0.05) 2.5%,
        rgba(139, 92, 246, 0) 2.5%
      );
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .grid-gradient {
    position: fixed;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(13, 12, 18, 0) 0%,
      rgba(13, 12, 18, 0.5) 50%,
      #0d0c12 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  .homepage-main {
    position: relative;
    z-index: 1;
  }

  /* Hero Section */
  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 132px 24px;
    position: relative;
    z-index: 1;
  }

  /* Announcement Badge */
  .announcement-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 13px;
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 9999px;
    margin-bottom: 32px;
  }

  .announcement-dot {
    width: 8px;
    height: 8px;
    background: #8b5cf6;
    border-radius: 50%;
    opacity: 0.75;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.75;
    }
    50% {
      opacity: 1;
    }
  }

  .announcement-text {
    font-family: "Fira Code", "SF Mono", Monaco, "Cascadia Code", monospace;
    font-size: 12px;
    color: #8b5cf6;
  }

  /* Hero Title */
  .hero-title {
    font-family: "Fira Code", "SF Mono", Monaco, "Cascadia Code", monospace;
    font-size: 96px;
    font-weight: 500;
    color: #ffffff;
    letter-spacing: -0.035em;
    margin: 0 0 32px 0;
    text-align: center;
  }

  /* Hero Subtitle */
  .hero-subtitle {
    font-family: "Instrument Serif", Georgia, serif;
    font-size: 72px;
    font-style: italic;
    color: #cbd5e1;
    line-height: 72px;
    text-align: center;
    max-width: 896px;
    margin: 0 0 48px 0;
  }

  /* Hero Buttons */
  .hero-buttons {
    display: flex;
    gap: 16px;
    margin-bottom: 80px;
  }

  .btn-primary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 24px;
    min-width: 160px;
    height: 48px;
    background: #8b5cf6;
    border: none;
    border-radius: 4px;
    font-family: "Fira Code", "SF Mono", Monaco, monospace;
    font-size: 14px;
    font-weight: 500;
    color: #ffffff;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.3);
    transition: all 0.2s ease;
  }

  .btn-primary:hover {
    background: #7c3aed;
    box-shadow: 0 0 30px rgba(139, 92, 246, 0.3);
  }

  .btn-primary-icon {
    width: 9.333px;
    height: 9.333px;
  }

  .btn-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 160px;
    height: 48px;
    padding: 13.5px 42px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    font-family: "Fira Code", "SF Mono", Monaco, monospace;
    font-size: 14px;
    font-weight: 500;
    color: #ffffff;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: #94a3b8;
  }

  /* Loop Demo Section */
  .loop-section {
    padding: 0 24px 96px;
    position: relative;
    z-index: 1;
  }

  .loop-container {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .loop-label {
    font-family: "Fira Code", "SF Mono", Monaco, monospace;
    font-size: 12px;
    color: var(--accent, #8b5cf6);
    text-transform: uppercase;
    letter-spacing: 2.4px;
    margin: 0 0 8px 0;
  }

  .loop-title {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 30px;
    font-weight: 700;
    color: var(--text-primary, #ffffff);
    line-height: 36px;
    margin: 0;
    text-align: center;
  }

  .loop-subtitle {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 16px;
    color: var(--text-muted, #94a3b8);
    line-height: 26px;
    max-width: 640px;
    margin: 16px 0 8px 0;
    text-align: center;
  }

  .loop-container .ac-widget-standalone {
    width: 100%;
  }

  .loop-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Fira Code", "SF Mono", Monaco, monospace;
    font-size: 13px;
    color: var(--accent, #8b5cf6);
    text-decoration: none;
    margin-top: 8px;
  }

  .loop-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Explore Section: alternating widget rows */
  .explore-section {
    padding: 0 24px 96px;
    position: relative;
    z-index: 1;
  }

  .explore-container {
    max-width: 1152px;
    margin: 0 auto;
  }

  .explore-header {
    text-align: left;
    margin-bottom: 64px;
  }

  .explore-heading {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 30px;
    font-weight: 700;
    color: var(--text-primary, #ffffff);
    line-height: 36px;
    margin: 0;
  }

  .explore-sub {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 16px;
    color: var(--text-muted, #94a3b8);
    line-height: 26px;
    max-width: 640px;
    margin: 16px 0 0;
  }

  .explore-row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px;
    align-items: center;
  }

  .explore-row + .explore-row {
    margin-top: 88px;
  }

  .explore-row-flip {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }

  /* Wider widget column for widgets with two internal panes (ConfigExplorer's
     tree needs ~720px before file names stop truncating). */
  .explore-row-wide.explore-row-flip {
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
  }

  .explore-row-flip .explore-copy {
    order: 2;
  }

  .explore-row-flip .explore-widget {
    order: 1;
  }

  .explore-widget {
    min-width: 0;
  }

  .explore-row-title {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: var(--text-primary, #ffffff);
    line-height: 30px;
    margin: 0;
  }

  .explore-row-desc {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 16px;
    color: var(--text-muted, #94a3b8);
    line-height: 26px;
    margin: 16px 0 0 0;
  }

  .explore-row-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Fira Code", "SF Mono", Monaco, monospace;
    font-size: 13px;
    color: var(--accent, #8b5cf6);
    text-decoration: none;
    margin-top: 16px;
  }

  .explore-row-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Features Section */
  .features-section {
    padding: 81px 80px 80px;
    background: rgba(13, 12, 18, 0.5);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
    z-index: 1;
  }

  .features-container {
    max-width: 1152px;
    margin: 0 auto;
  }

  .features-header {
    margin-bottom: 48px;
  }

  .features-title {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 30px;
    font-weight: 700;
    color: #ffffff;
    line-height: 36px;
    margin: 0;
  }

  .features-subtitle {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 16px;
    color: #94a3b8;
    line-height: 26px;
    max-width: 640px;
    margin: 16px 0 0 0;
  }

  .feature-card-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
    transition:
      opacity 0.3s ease,
      filter 0.3s ease;
  }

  .feature-card-link:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .features-grid:hover .feature-card-link:not(:hover) {
    opacity: 0.5;
    filter: grayscale(40%);
  }

  /* Responsive Styles */
  @media (max-width: 1024px) {
    .hero-title {
      font-size: 72px;
      letter-spacing: -0.035em;
    }

    .hero-subtitle {
      font-size: 56px;
      line-height: 56px;
    }

    .explore-row,
    .explore-row-flip,
    .explore-row-wide.explore-row-flip {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      max-width: 820px;
      margin-left: auto;
      margin-right: auto;
    }

    .explore-row-flip .explore-copy {
      order: 1;
    }

    .explore-row-flip .explore-widget {
      order: 2;
    }

    .explore-row + .explore-row {
      margin-top: 64px;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 80px 24px;
    }

    .hero-title {
      font-size: 48px;
      letter-spacing: -0.035em;
    }

    .hero-subtitle {
      font-size: 32px;
      line-height: 40px;
    }

    .hero-buttons {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      justify-content: center;
    }

    .loop-section {
      padding: 0 24px 64px;
    }

    .loop-title {
      font-size: 24px;
      line-height: 30px;
    }

    .features-section {
      padding: 60px 24px;
    }

    .explore-section {
      padding: 0 24px 64px;
    }

    .explore-header {
      margin-bottom: 48px;
    }

    .explore-heading {
      font-size: 24px;
      line-height: 30px;
    }

    .explore-row,
    .explore-row-flip,
    .explore-row-wide.explore-row-flip {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }

    .explore-row-flip .explore-copy {
      order: 1;
    }

    .explore-row-flip .explore-widget {
      order: 2;
    }

    .explore-row + .explore-row {
      margin-top: 64px;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
