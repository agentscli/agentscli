---
// Blog Sidebar — lists real tags pulled from blog post frontmatter.
interface Props {
  tags?: string[];
  activeTag?: string;
}

const { tags = [], activeTag } = Astro.props;

function formatTag(tag: string) {
  return tag.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}
---

<aside class="blog-sidebar">
  {tags.length > 0 && (
    <div class="sidebar-section">
      <h3 class="sidebar-heading">Topics</h3>
      <nav class="sidebar-nav">
        {tags.map((tag) => (
          <a
            href={`/blog/tag/${tag}`}
            class:list={["sidebar-link", { active: activeTag === tag }]}
            data-track="sidebar-tag"
            data-tag={tag}
          >
            <div class="link-icon">
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 1.5h6l3.5 3.5v6L8 16 0 8l4-6.5z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" transform="scale(0.85) translate(1,0)"/>
                <circle cx="10" cy="5" r="1" fill="currentColor"/>
              </svg>
            </div>
            <span class="link-text">{formatTag(tag)}</span>
          </a>
        ))}
      </nav>
    </div>
  )}
</aside>

<style>
  .blog-sidebar {
    display: flex;
    flex-direction: column;
    gap: 32px;
    width: 256px;
    flex-shrink: 0;
    height: 100%;
    overflow-y: auto;
    scrollbar-width: none;
  }
  
  .blog-sidebar::-webkit-scrollbar {
    display: none;
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sidebar-heading {
    font-family: 'Geist Mono', 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    font-weight: 500;
    color: #f1f5f9;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin: 0;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 13px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .sidebar-link:hover {
    background: rgba(124, 105, 247, 0.05);
    border-color: rgba(124, 105, 247, 0.1);
  }

  .sidebar-link.active {
    background: rgba(124, 105, 247, 0.1);
    border-color: rgba(124, 105, 247, 0.2);
  }

  .link-icon {
    width: 15px;
    height: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    flex-shrink: 0;
  }

  .sidebar-link.active .link-icon {
    color: #7c69f7;
  }

  .link-icon svg {
    width: 100%;
    height: 100%;
  }

  .link-text {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #94a3b8;
  }

  .sidebar-link.active .link-text {
    color: #7c69f7;
  }

  @media (max-width: 1024px) {
    .blog-sidebar {
      display: none;
    }
  }
</style>
