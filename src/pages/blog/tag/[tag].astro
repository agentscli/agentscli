---
// Blog Tag Page - one static page per tag
import { getCollection } from 'astro:content';
import BlogLayout from "../../../components/BlogLayout.astro";
import BlogSidebar from "../../../components/BlogSidebar.astro";
import BlogPostCard from "../../../components/BlogPostCard.astro";
import Head from "../../../components/Head.astro";
import { getHero } from "../../../lib/cover";
import { isPublishedPost } from "../../../lib/blog";

const authorMap: Record<string, { name: string; initials: string }> = {
  sourabh: { name: "Sourabh Kushwah", initials: "SO" },
  sanjay: { name: "Sanjay Kushwah", initials: "SA" },
};

export async function getStaticPaths() {
  const blogPosts = (await getCollection('blog')).filter(isPublishedPost);
  const tags = new Set<string>();
  for (const p of blogPosts) {
    const t = (p.data as any).tags;
    if (Array.isArray(t)) t.forEach((x: string) => tags.add(x));
  }
  return [...tags].map(tag => ({ params: { tag } }));
}

const { tag } = Astro.params;

const allPosts = (await getCollection('blog'))
  .filter(isPublishedPost)
  .sort((a, b) =>
    new Date(b.data.date as Date).valueOf() - new Date(a.data.date as Date).valueOf()
  );

const posts = allPosts.filter(p => (p.data as any).tags?.includes(tag));
const allTags = [...new Set(allPosts.flatMap(p => (p.data as any).tags || []))] as string[];

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function calculateReadTime(content: string): string {
  const wordCount = content.split(/\s+/).length;
  const minutes = Math.ceil(wordCount / 200);
  return `${minutes} MIN READ`;
}

function getAuthor(post: typeof allPosts[0]): { name: string; initials: string } {
  const data = post.data as any;
  if (data.authors) {
    if (typeof data.authors === 'string') {
      return authorMap[data.authors] || { name: data.authors, initials: "??" };
    }
    if (typeof data.authors === 'object' && data.authors.name) {
      return { name: data.authors.name, initials: data.authors.name.split(' ').map((n: string) => n[0]).join('').toUpperCase() };
    }
  }
  return { name: "Unknown", initials: "??" };
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`Posts tagged #${tag} on agents.cli.`}
    />
    <title>#{tag} | agents.cli</title>
    <link
      rel="canonical"
      href={new URL(
        Astro.url.pathname.endsWith("/")
          ? Astro.url.pathname
          : Astro.url.pathname + "/",
        Astro.site ?? "https://www.agentscli.com",
      ).href}
    />
    <Head />
  </head>
  <body>
    <BlogLayout>
      <div class="blog-page">
        <section class="main-content">
          <div class="content-wrapper">
            <BlogSidebar tags={allTags} activeTag={tag} />
            <div class="blog-feed">
              <div class="blog-header">
                <h1 class="blog-title">#{tag}</h1>
                <p class="blog-description">
                  {posts.length} post{posts.length === 1 ? '' : 's'} tagged <code>#{tag}</code>.
                </p>
              </div>

              <div class="tags-container">
                <a href="/blog" class="tag-pill" data-track="tag-filter" data-tag="all">
                  #all
                </a>
                {allTags.map((t) => (
                  <a
                    href={`/blog/tag/${t}/`}
                    class:list={["tag-pill", { active: tag === t }]}
                    data-track="tag-filter"
                    data-tag={t}
                  >
                    #{t}
                  </a>
                ))}
              </div>

              <div class="posts-list">
                {posts.map((post, index) => {
                  const data = post.data as any;
                  const author = getAuthor(post);
                  const heroImage = getHero(post.id);
                  return (
                    <>
                      <BlogPostCard
                        image={heroImage}
                        category={data.category || "DISCOVERIES"}
                        date={formatDate(new Date(data.date))}
                        title={post.data.seoTitle || post.data.title}
                        description={data.excerpt || data.description || ""}
                        authorInitials={author.initials}
                        authorName={author.name}
                        readTime={calculateReadTime(post.body ?? '')}
                        href={`/blog/${post.id.replace('blog/', '')}`}
                        tags={data.tags}
                      />
                      {index < posts.length - 1 && <div class="post-separator" />}
                    </>
                  );
                })}
              </div>
            </div>
          </div>
        </section>
      </div>
    </BlogLayout>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }

  body {
    background-color: #0a0a0f;
    color: #ffffff;
    min-height: 100vh;
    overflow-x: hidden;
  }
</style>

<style>
  .blog-page {
    position: relative;
    z-index: 1;
  }

  .main-content {
    display: flex;
    justify-content: center;
    padding: 48px 80px 48px;
    min-height: calc(100vh - 82px);
  }

  .content-wrapper {
    display: flex;
    gap: 48px;
    max-width: 1280px;
    width: 100%;
    align-items: flex-start;
  }

  .blog-feed {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 40px;
    min-width: 0;
  }

  .blog-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 8px;
  }

  .blog-title {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 36px;
    font-weight: 800;
    color: #f1f5f9;
    letter-spacing: -0.9px;
    line-height: 40px;
    margin: 0;
  }

  .blog-description {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 18px;
    color: #94a3b8;
    line-height: 29.25px;
    margin: 0;
    max-width: 672px;
  }

  .blog-description code {
    font-family: 'Geist Mono', 'Fira Code', 'SF Mono', Monaco, monospace;
    color: #7c69f7;
    background: rgba(124, 105, 247, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 16px;
  }

  .tags-container {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding-bottom: 16px;
  }

  .tag-pill {
    display: flex;
    align-items: center;
    padding: 5px 13px;
    background: #111118;
    border: 1px solid #1e1e26;
    border-radius: 9999px;
    font-family: 'Geist Mono', 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    font-weight: 500;
    color: #94a3b8;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .tag-pill:hover {
    background: rgba(124, 105, 247, 0.1);
    border-color: rgba(124, 105, 247, 0.2);
    color: #7c69f7;
  }

  .tag-pill.active {
    background: rgba(124, 105, 247, 0.15);
    border-color: rgba(124, 105, 247, 0.3);
    color: #7c69f7;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .post-separator {
    height: 1px;
    background: #1e1e26;
    width: 100%;
  }

  @media (max-width: 1200px) {
    .main-content {
      padding: 48px 40px;
    }
  }

  @media (max-width: 1024px) {
    .content-wrapper {
      flex-direction: column;
    }

    .blog-feed {
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .main-content {
      padding: 32px 24px;
    }

    .blog-title {
      font-size: 28px;
      letter-spacing: -0.7px;
      line-height: 32px;
    }

    .blog-description {
      font-size: 16px;
      line-height: 24px;
    }
  }
</style>
