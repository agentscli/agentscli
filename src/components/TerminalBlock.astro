---
// Terminal Block Component - For code/terminal displays in blog posts
export interface CommandSection {
  main: string;
  completed?: string[];
  warnings?: string[];
  outputs?: string[];
}

interface Props {
  title?: string;
  commands?: CommandSection[];
}

const {
  title = "bash",
  commands = []
} = Astro.props;
---

<div class="terminal-block">
  <div class="terminal-header-bar">
    <div class="terminal-dots">
      <div class="terminal-dot red"></div>
      <div class="terminal-dot yellow"></div>
      <div class="terminal-dot green"></div>
    </div>
    <span class="terminal-title-text">{title}</span>
  </div>
  <div class="terminal-body">
    {commands.map((cmd) => (
      <>
        <div class="terminal-line">
          <span class="terminal-prompt">&gt;</span>
          <span class="terminal-command">{cmd.main}</span>
        </div>
        
        {cmd.completed?.map((comp) => (
          <div class="terminal-line">
            <span class="terminal-prompt" style="opacity: 0">&gt;</span>
            <span class="terminal-success">✔</span>
            <span class="terminal-output"> {comp}</span>
          </div>
        ))}

        {cmd.warnings?.map((warn) => {
          // Check if there's a highlight like "Missing environment variable: DB_URL"
          // We can split loosely to keep the inline code block style
          const parts = warn.split(": ");
          return (
            <div class="terminal-line">
              <span class="terminal-prompt" style="opacity: 0">&gt;</span>
              <span class="terminal-warning">!</span>
              <span class="terminal-output"> {parts[0]}{parts.length > 1 ? ":" : ""}</span>
              {parts.length > 1 && (
                <span class="terminal-code-inline">{parts.slice(1).join(": ")}</span>
              )}
            </div>
          );
        })}

        {cmd.outputs?.map((out) => (
          <div class="terminal-line">
            <span class="terminal-prompt" style="opacity: 0">&gt;</span>
            <span class="terminal-output">{out}</span>
          </div>
        ))}
      </>
    ))}
    
    <div class="terminal-line">
      <span class="terminal-prompt">&gt;</span>
      <span class="terminal-cursor">_</span>
    </div>
    <slot />
  </div>
</div>

<style>
  .terminal-block {
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    margin: 56px 0;
  }

  .terminal-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px 9px;
    background: rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .terminal-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 9999px;
  }

  .terminal-dot.red { background: rgba(239, 68, 68, 0.5); }
  .terminal-dot.yellow { background: rgba(234, 179, 8, 0.5); }
  .terminal-dot.green { background: rgba(34, 197, 94, 0.5); }

  .terminal-title-text {
    font-family: 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 10px;
    font-weight: 400;
    color: #9890cb;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .terminal-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .terminal-line {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-family: 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 14px;
    line-height: 22.75px;
  }

  .terminal-prompt {
    /* full-strength lavender on the fixed-dark terminal; opacity:0.5 read ~1.6:1 (AA fail) */
    color: #9d8ffe;
    flex-shrink: 0;
  }

  .terminal-command {
    color: #ffffff;
  }

  .terminal-output {
    color: #9890cb;
  }

  .terminal-success {
    color: #4ade80;
  }

  .terminal-warning {
    color: #facc15;
  }

  .terminal-error {
    color: #ef4444;
  }

  .terminal-cursor {
    color: #7c69f7;
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-cursor {
      animation: none;
    }
  }

  .terminal-code-inline {
    background: rgba(255, 255, 255, 0.1);
    padding: 2px 4px;
    border-radius: 4px;
    margin-left: 4px;
    color: #9890cb;
  }
</style>
