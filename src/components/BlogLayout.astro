---
// Blog Layout Component
import BlogHeader from "./BlogHeader.astro";
import BlogFooter from "./BlogFooter.astro";

---

<div class="blog-container">
  <div class="grid-background"></div>
  <div class="grid-gradient"></div>
  <BlogHeader />
  <main class="blog-main">
    <slot />
  </main>
  <BlogFooter />
</div>

<style>
  .blog-container {
    background-color: #0a0a0f;
    color: #ffffff;
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
  }

  .grid-background {
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(
        90deg,
        rgba(124, 105, 247, 0.05) 2.5%,
        rgba(124, 105, 247, 0) 2.5%
      ),
      linear-gradient(
        180deg,
        rgba(124, 105, 247, 0.05) 2.5%,
        rgba(124, 105, 247, 0) 2.5%
      );
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .grid-gradient {
    position: fixed;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10, 10, 15, 0) 0%,
      rgba(10, 10, 15, 0.5) 50%,
      #0a0a0f 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  .blog-main {
    position: relative;
    z-index: 1;
  }
</style>
