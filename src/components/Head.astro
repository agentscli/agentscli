---
// Custom Head Component for fonts
// (The anti-FOUC theme bootstrap lives as the first child of <head> in the
// page itself so it runs before any CSS — see src/pages/index.astro.)
---

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

<!-- Font face declarations for fallback -->
<style>
  :root {
    --font-mono: 'Fira Code', 'SF Mono', Monaco, 'Cascadia Code', monospace;
    --font-display: 'Space Grotesk', system-ui, sans-serif;
    --font-serif: 'Instrument Serif', Georgia, serif;
  }
</style>
