---
// Blog Post Card Component - Figma Design
interface Props {
  image: string;
  category: string;
  date: string;
  title: string;
  description: string;
  authorInitials: string;
  authorName: string;
  readTime: string;
  href?: string;
}

const {
  image,
  category,
  date,
  title,
  description,
  authorInitials,
  authorName,
  readTime,
  href = "#"
} = Astro.props;
---

<article class="post-card">
  <a href={href} class="post-image-link">
    <div class="post-image-container">
      <img src={image} alt={title} class="post-image" loading="lazy" />
    </div>
  </a>
  <div class="post-content">
    <div class="post-meta">
      <span class="post-category">{category}</span>
      <span class="meta-separator">•</span>
      <span class="post-date">{date}</span>
    </div>
    <h2 class="post-title">
      <a href={href}>{title}</a>
    </h2>
    <p class="post-description">{description}</p>
    <div class="post-footer">
      <div class="author-info">
        <div class="author-avatar">
          <span class="author-initials">{authorInitials}</span>
        </div>
        <span class="author-name">{authorName}</span>
      </div>
      <span class="read-time">{readTime}</span>
    </div>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .post-image-link {
    flex-shrink: 0;
    text-decoration: none;
  }

  .post-image-container {
    width: 270px;
    aspect-ratio: 4/3;
    background: #111118;
    border: 1px solid #1e1e26;
    border-radius: 12px;
    overflow: hidden;
  }

  .post-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .post-category {
    font-family: 'Geist Mono', 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    font-weight: 500;
    color: #7c69f7;
  }

  .meta-separator {
    font-family: 'Geist Mono', 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    font-weight: 400;
    color: #475569;
  }

  .post-date {
    font-family: 'Geist Mono', 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    font-weight: 400;
    color: #64748b;
    text-transform: uppercase;
  }

  .post-title {
    margin: 0;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 24px;
    font-weight: 700;
    line-height: 30px;
    color: #f1f5f9;
  }

  .post-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .post-title a:hover {
    color: #7c69f7;
  }

  .post-description {
    margin: 0;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 26px;
    color: #94a3b8;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 8px;
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .author-avatar {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(124, 105, 247, 0.2);
    border: 1px solid rgba(124, 105, 247, 0.3);
    border-radius: 9999px;
  }

  .author-initials {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 700;
    color: #7c69f7;
  }

  .author-name {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: #64748b;
  }

  .read-time {
    font-family: 'Geist Mono', 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    font-weight: 400;
    color: #475569;
  }

  @media (max-width: 900px) {
    .post-card {
      flex-direction: column;
      gap: 20px;
    }

    .post-image-container {
      width: 100%;
      max-width: 400px;
    }

    .post-content {
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: 20px;
      line-height: 26px;
    }

    .post-description {
      font-size: 14px;
      line-height: 22px;
    }
  }
</style>
