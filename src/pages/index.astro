---
// Homepage - agents.cli
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FeatureCard from "../components/FeatureCard.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="A publication on context engineering — closing the gap between AI coding agents and the context they don't have."
    />
    <title>agents.cli</title>
    <Head />
  </head>
  <body>
    <div class="homepage-container">
      <div class="grid-background"></div>
      <div class="grid-gradient"></div>
      <Header />
      <main class="homepage-main">
        <!-- Hero Section -->
        <section class="hero-section">
          <!-- Eyebrow -->
          <div class="announcement-badge">
            <span class="announcement-dot"></span>
            <span class="announcement-text">A publication on context engineering</span>
          </div>

          <!-- Main Title -->
          <h1 class="hero-title">agents.cli</h1>

          <!-- Subtitle -->
          <p class="hero-subtitle">
            "Agents are capable.<br />
            They're just missing your context."
          </p>

          <!-- CTA Buttons -->
          <div class="hero-buttons">
            <a href="/course/" class="btn-primary">
              <span>Start a course</span>
              <svg
                class="btn-primary-icon"
                width="10"
                height="10"
                viewBox="0 0 10 10"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M5 0.833252L4.0625 1.77075L7.02083 4.72909H0.833328V5.93742H7.02083L4.0625 8.89575L5 9.83325L9.16666 5.33325L5 0.833252Z"
                  fill="currentColor"></path>
              </svg>
            </a>
            <a href="/foundations/" class="btn-secondary">
              <span>Read the foundations</span>
            </a>
          </div>
        </section>

        <!-- Features Section -->
        <section class="features-section">
          <div class="features-container">
            <div class="features-header">
              <p class="features-label">What you'll find here</p>
              <h2 class="features-title">Three surfaces. One thesis.</h2>
              <p class="features-subtitle">
                Agents are broad, fast, and contextless. The humans they work with are the
                inverse — slower and narrower, but rich in context. Everything on this site
                is about closing that gap.
              </p>
            </div>
            <div class="features-grid">
              <a href="/course/" class="feature-card-link feature-card-wide">
                <FeatureCard
                  title="The courses"
                  description="Learn by doing, one agent at a time. Pick Claude Code or Codex and<br />take a real project across a week of work — from your first change to<br />running it headless in CI. Each lesson is a real problem and the move that fixes it."
                  icon="comparison"
                />
              </a>
              <a href="/foundations/" class="feature-card-link">
                <FeatureCard
                  title="Foundations"
                  description="Thirteen techniques for closing the agent–context<br />gap. Rules, subagents, skills, MCP, hooks, plan mode,<br />permissions, and the rest of the toolkit."
                  icon="rules"
                />
              </a>
              <a href="/blog" class="feature-card-link">
                <FeatureCard
                  title="Blog"
                  description="Essays on how teams actually work with AI coding<br />agents — what compounds, what doesn't, and what's<br />still unsettled."
                  icon="skills"
                />
              </a>
            </div>
          </div>
        </section>
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: "Space Grotesk", system-ui, sans-serif;
  }

  body {
    background-color: #0d0c12;
    color: #ffffff;
    min-height: 100vh;
  }
</style>

<style>
  .homepage-container {
    background-color: #0d0c12;
    color: #ffffff;
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
  }

  .grid-background {
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(
        90deg,
        rgba(139, 92, 246, 0.05) 2.5%,
        rgba(139, 92, 246, 0) 2.5%
      ),
      linear-gradient(
        180deg,
        rgba(139, 92, 246, 0.05) 2.5%,
        rgba(139, 92, 246, 0) 2.5%
      );
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .grid-gradient {
    position: fixed;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(13, 12, 18, 0) 0%,
      rgba(13, 12, 18, 0.5) 50%,
      #0d0c12 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  .homepage-main {
    position: relative;
    z-index: 1;
  }

  /* Hero Section */
  .hero-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 132px 24px;
    position: relative;
    z-index: 1;
  }

  /* Announcement Badge */
  .announcement-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 13px;
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 9999px;
    margin-bottom: 32px;
  }

  .announcement-dot {
    width: 8px;
    height: 8px;
    background: #8b5cf6;
    border-radius: 50%;
    opacity: 0.75;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.75;
    }
    50% {
      opacity: 1;
    }
  }

  .announcement-text {
    font-family: "Fira Code", "SF Mono", Monaco, "Cascadia Code", monospace;
    font-size: 12px;
    color: #8b5cf6;
  }

  /* Hero Title */
  .hero-title {
    font-family: "Fira Code", "SF Mono", Monaco, "Cascadia Code", monospace;
    font-size: 96px;
    font-weight: 500;
    color: #ffffff;
    letter-spacing: -4.8px;
    margin: 0 0 32px 0;
    text-align: center;
  }

  /* Hero Subtitle */
  .hero-subtitle {
    font-family: "Instrument Serif", Georgia, serif;
    font-size: 72px;
    font-style: italic;
    color: #cbd5e1;
    line-height: 72px;
    text-align: center;
    max-width: 896px;
    margin: 0 0 48px 0;
  }

  /* Hero Buttons */
  .hero-buttons {
    display: flex;
    gap: 16px;
    margin-bottom: 80px;
  }

  .btn-primary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 24px;
    min-width: 160px;
    height: 48px;
    background: #8b5cf6;
    border: none;
    border-radius: 4px;
    font-family: "Fira Code", "SF Mono", Monaco, monospace;
    font-size: 14px;
    font-weight: 500;
    color: #ffffff;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.3);
    transition: all 0.2s ease;
  }

  .btn-primary:hover {
    background: #7c3aed;
    box-shadow: 0 0 30px rgba(139, 92, 246, 0.3);
  }

  .btn-primary-icon {
    width: 9.333px;
    height: 9.333px;
  }

  .btn-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 160px;
    height: 48px;
    padding: 13.5px 42px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    font-family: "Fira Code", "SF Mono", Monaco, monospace;
    font-size: 14px;
    font-weight: 500;
    color: #ffffff;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: #94a3b8;
  }

  /* Features Section */
  .features-section {
    padding: 81px 80px 80px;
    background: rgba(13, 12, 18, 0.5);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
    z-index: 1;
  }

  .features-container {
    max-width: 1152px;
    margin: 0 auto;
  }

  .features-header {
    margin-bottom: 48px;
  }

  .features-label {
    font-family: "Fira Code", "SF Mono", Monaco, monospace;
    font-size: 12px;
    color: #8b5cf6;
    text-transform: uppercase;
    letter-spacing: 2.4px;
    margin: 0 0 8px 0;
  }

  .features-title {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 30px;
    font-weight: 700;
    color: #ffffff;
    line-height: 36px;
    margin: 0;
  }

  .features-subtitle {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 16px;
    color: #94a3b8;
    line-height: 26px;
    max-width: 640px;
    margin: 16px 0 0 0;
  }

  .feature-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  /* The course leads the grid as a full-width card. */
  .feature-card-wide {
    grid-column: 1 / -1;
  }

  /* Responsive Styles */
  @media (max-width: 1024px) {
    .hero-title {
      font-size: 72px;
      letter-spacing: -3.6px;
    }

    .hero-subtitle {
      font-size: 56px;
      line-height: 56px;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 80px 24px;
    }

    .hero-title {
      font-size: 48px;
      letter-spacing: -2.4px;
    }

    .hero-subtitle {
      font-size: 32px;
      line-height: 40px;
    }

    .hero-buttons {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      justify-content: center;
    }

    .features-section {
      padding: 60px 24px;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
