---
// Blog Footer Component - Bolder "Blob" Design
---

<footer class="blog-footer">
  <div class="footer-blob-container">
    <div class="footer-blob"></div>
    <div class="footer-blob footer-blob-2"></div>
  </div>
  
  <div class="footer-main">
    <div class="footer-brand">
      <div class="brand-header">
        <div class="brand-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="24" height="24" rx="6" fill="var(--sl-color-accent)"/>
            <path d="M6 7.5h4.5v1.5H7.5v2.25h3v1.5h-3v3.75H6V7.5zm7.5 0h3c1.24 0 2.25 1.01 2.25 2.25s-1.01 2.25-2.25 2.25h-1.5v3H13.5V7.5zm3 3c.41 0 .75-.34.75-.75s-.34-.75-.75-.75h-1.5v1.5h1.5z" fill="var(--sl-color-text-on-accent)"/>
          </svg>
        </div>
        <span class="brand-text">agents.cli</span>
      </div>
      <p class="brand-description">
        Notes on context engineering, AI coding agents,
        and the repo knowledge developers need to write
        down once.
      </p>
    </div>

    <div class="footer-links-section">
      <div class="footer-column">
        <h4 class="column-heading">Resources</h4>
        <nav class="column-nav">
          <a href="/foundations/" class="column-link">Foundations</a>
          <a href="/foundations/rules/" class="column-link">Rules</a>
          <a href="/foundations/mcp-servers/" class="column-link">MCP servers</a>
          <a href="/foundations/skills/" class="column-link">Skills</a>
        </nav>
      </div>

      <div class="footer-column">
        <h4 class="column-heading">Explore</h4>
        <nav class="column-nav">
          <a href="/blog" class="column-link">Blog</a>
          <a href="/blog/tag/context-engineering/" class="column-link">Context engineering</a>
          <a href="/blog/tag/rules/" class="column-link">Rules essays</a>
          <a href="https://github.com/agentscli" class="column-link" target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="bottom-border">
      <div class="bottom-content">
        <span class="copyright">© 2024 AGENTS.CLI, SYSTEM_STABLE_v2.4.0</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .blog-footer {
    background: var(--sl-color-black);
    border-top: 1px solid var(--sl-color-hairline);
    padding: 96px 80px 48px;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  .footer-blob-container {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    z-index: -1;
    pointer-events: none;
  }

  .footer-blob {
    position: absolute;
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, var(--sl-color-accent) 0%, transparent 60%);
    opacity: 0.12;
    border-radius: 50%;
    filter: blur(80px);
    top: -400px;
    right: -200px;
    animation: blob-float 25s ease-in-out infinite alternate;
  }

  .footer-blob-2 {
    width: 600px;
    height: 600px;
    top: auto;
    bottom: -300px;
    left: -100px;
    right: auto;
    background: radial-gradient(circle, var(--sl-color-accent-high) 0%, transparent 60%);
    opacity: 0.08;
    animation: blob-float-2 20s ease-in-out infinite alternate;
  }

  @keyframes blob-float {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-100px, 50px) scale(1.2); }
  }

  @keyframes blob-float-2 {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(80px, -60px) scale(1.1); }
  }

  .footer-main {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    gap: 80px;
    justify-content: flex-start;
    margin-bottom: 80px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 420px;
  }

  .brand-header {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .brand-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-icon svg {
    width: 100%;
    height: 100%;
  }

  .brand-text {
    font-family: var(--sl-font-heading);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -1px;
    color: var(--sl-color-white);
  }

  .brand-description {
    font-family: var(--sl-font);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.7;
    color: var(--sl-color-gray-2);
    margin: 0;
  }

  .footer-links-section {
    display: flex;
    gap: 80px;
    margin-left: auto;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 244px;
  }

  .column-heading {
    font-family: var(--sl-font-heading);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    margin: 0;
  }

  .column-nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .column-link {
    font-family: var(--sl-font);
    font-size: 15px;
    font-weight: 400;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
    transform-origin: left;
  }

  .column-link:hover {
    color: var(--sl-color-text-accent);
    transform: translateX(4px);
  }

  .footer-bottom {
    max-width: 1280px;
    margin: 0 auto;
  }

  .bottom-border {
    border-top: 1px solid var(--sl-color-hairline);
    padding-top: 40px;
  }

  .bottom-content {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .copyright {
    font-family: var(--sl-font-mono);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--sl-color-gray-2);
  }

  @media (max-width: 1200px) {
    .blog-footer {
      padding: 80px 40px 48px;
    }

    .footer-links-section {
      gap: 48px;
    }

    .footer-column {
      width: 200px;
    }
  }

  @media (max-width: 900px) {
    .footer-main {
      flex-direction: column;
      gap: 48px;
      margin-bottom: 48px;
    }

    .footer-links-section {
      margin-left: 0;
      flex-wrap: wrap;
    }

    .footer-column {
      width: auto;
      min-width: 180px;
    }
  }

  @media (max-width: 768px) {
    .blog-footer {
      padding: 64px 24px 40px;
    }

    .footer-main {
      gap: 40px;
    }

    .footer-brand {
      max-width: 100%;
    }

    .footer-links-section {
      flex-direction: column;
      gap: 32px;
    }

    .footer-column {
      width: 100%;
    }
    
    .footer-blob {
      width: 400px;
      height: 400px;
      filter: blur(50px);
      right: -100px;
    }

    .bottom-content {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-blob,
    .footer-blob-2 {
      animation: none;
    }
    .column-link {
      transition: none;
    }
    .column-link:hover {
      transform: none;
    }
  }
</style>
