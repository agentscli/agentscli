---
// Light/dark toggle for the custom (non-Starlight) routes: homepage and blog.
// Same storage key and behaviour as the Starlight ThemeSelect override
// (src/components/ThemeSelect.astro), so a choice made on a docs page carries
// over here and back. Styled with the custom-route tokens from Head.astro.
---

<site-theme-toggle>
  <button
    type="button"
    class="site-theme-toggle"
    aria-label="Toggle color theme"
    aria-pressed="false"
    title="Toggle light/dark theme"
  >
    <svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
    </svg>
    <svg class="icon-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </button>
</site-theme-toggle>

<style>
  .site-theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--text-secondary);
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .site-theme-toggle:hover {
    background: var(--surface-bg);
    border-color: var(--accent-border);
    color: var(--text-primary);
  }
  .site-theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .site-theme-toggle svg {
    width: 1.1rem;
    height: 1.1rem;
  }
  /* Show sun in dark mode (click to go light), moon in light mode. */
  :global([data-theme='dark']) .site-theme-toggle .icon-moon,
  :global([data-theme='light']) .site-theme-toggle .icon-sun {
    display: none;
  }
</style>

<script>
  const storageKey = 'starlight-theme';

  class SiteThemeToggle extends HTMLElement {
    constructor() {
      super();
      const button = this.querySelector('button');
      const current = () =>
        document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      const sync = () => {
        button?.setAttribute('aria-pressed', current() === 'dark' ? 'true' : 'false');
      };
      sync();
      button?.addEventListener('click', () => {
        const next = current() === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem(storageKey, next);
        } catch {}
        sync();
      });
    }
  }
  customElements.define('site-theme-toggle', SiteThemeToggle);
</script>
