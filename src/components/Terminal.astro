---
// Terminal Preview Component
---

<div class="terminal-container">
  <div class="terminal">
    <div class="terminal-header">
      <div class="terminal-dot red"></div>
      <div class="terminal-dot yellow"></div>
      <div class="terminal-dot green"></div>
      <span class="terminal-title">zsh — 80x24</span>
    </div>
    <div class="terminal-body">
      <div class="terminal-line">
        <span class="terminal-prompt">$</span>
        <span class="terminal-command">agents skill install @web/search</span>
      </div>
      <div class="terminal-line">
        <span class="terminal-output">✔ Skill 'search' linked to local runtime</span>
      </div>
      <div class="terminal-line" style="padding-top: 12px;">
        <span class="terminal-prompt">$</span>
        <span class="terminal-command">agents run "Find recent news about agents.cli"</span>
      </div>
      <div class="terminal-line">
        <span class="terminal-success">Thinking... Using Skill: Search</span>
      </div>
      <div class="terminal-line terminal-indented">
        <span class="terminal-output">Based on my search, agents.cli is gaining traction for its terminal-first<br/>approach to multi-agent orchestration...</span>
      </div>
    </div>
  </div>
</div>

<style>
  .terminal-container {
    width: 100%;
    max-width: 768px;
    margin: 0 auto;
  }

  .terminal {
    background: var(--ac-code-frame-bg);
    backdrop-filter: blur(6px);
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--ac-code-frame-shadow, 0 25px 50px -12px rgba(0, 0, 0, 0.25));
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px 13px;
    background: var(--ac-surface-hover);
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .terminal-dot.red { background: rgba(239, 68, 68, 0.5); }
  .terminal-dot.yellow { background: rgba(245, 158, 11, 0.5); }
  .terminal-dot.green { background: rgba(16, 185, 129, 0.5); }

  .terminal-title {
    margin-left: 8px;
    font-family: 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 10px;
    color: var(--sl-color-gray-2);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .terminal-body {
    padding: 23px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .terminal-line {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-family: 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 14px;
    line-height: 22.75px;
  }

  .terminal-prompt {
    color: var(--sl-color-text-accent);
    flex-shrink: 0;
  }

  .terminal-command {
    color: var(--sl-color-gray-1);
  }

  .terminal-output {
    color: var(--sl-color-gray-2);
  }

  .terminal-success {
    /* Theme-aware success green: darker on light for AA, brighter on dark. */
    color: var(--ac-terminal-success, #0f9d6b);
  }

  :global([data-theme='dark']) .terminal-success {
    color: #34d399;
  }

  .terminal-indented {
    border-left: 2px solid var(--sl-color-hairline-shade);
    padding-left: 18px;
    padding-top: 9px;
    padding-bottom: 4px;
    margin-top: 9px;
  }
</style>
