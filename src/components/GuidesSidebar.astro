---
// Guides Sidebar Navigation Component
---

<aside class="guides-sidebar">
  <div class="sidebar-header">
    <div class="sidebar-logo">
      <div class="logo-icon">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 0L6.5 1.5L11 6H0V10H11L6.5 14.5L8 16L16 8L8 0Z" fill="white"/>
        </svg>
      </div>
      <div class="logo-text">
        <span class="logo-title">agents.cli</span>
        <span class="logo-version">v1.2.0-stable</span>
      </div>
    </div>
  </div>

  <nav class="sidebar-nav">
    <!-- Getting Started Section -->
    <div class="nav-section">
      <h3 class="nav-heading">Getting Started</h3>
      <ul class="nav-list">
        <li class="nav-item">
          <a href="/guides/getting-started" class="nav-link">
            <svg class="nav-icon" width="10" height="12" viewBox="0 0 10 12" fill="none">
              <path d="M5 0L0 4.5H3V12H7V4.5H10L5 0Z" fill="currentColor"/>
            </svg>
            Introduction
          </a>
        </li>
        <li class="nav-item">
          <a href="/guides/installation" class="nav-link">
            <svg class="nav-icon" width="10" height="10" viewBox="0 0 10 10" fill="none">
              <path d="M5 0L0 5H3V10H7V5H10L5 0Z" fill="currentColor"/>
            </svg>
            Installation
          </a>
        </li>
        <li class="nav-item">
          <a href="/guides/quickstart" class="nav-link">
            <svg class="nav-icon" width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M6 0C2.686 0 0 2.686 0 6C0 9.314 2.686 12 6 12C9.314 12 12 9.314 12 6C12 2.686 9.314 0 6 0ZM7 9H5V5H7V9ZM7 4H5V2H7V4Z" fill="currentColor"/>
            </svg>
            Quickstart
          </a>
        </li>
      </ul>
    </div>

    <!-- Concepts Section -->
    <div class="nav-section">
      <h3 class="nav-heading">Concepts</h3>
      <ul class="nav-list">
        <li class="nav-item">
          <a href="/guides/agent-architecture" class="nav-link">
            <svg class="nav-icon" width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M6 0L0 3V9L6 12L12 9V3L6 0Z" fill="currentColor"/>
            </svg>
            Agent Architecture
          </a>
        </li>
        <li class="nav-item">
          <a href="/guides/memory-management" class="nav-link">
            <svg class="nav-icon" width="10" height="13" viewBox="0 0 10 13" fill="none">
              <path d="M5 0C2.243 0 0 2.243 0 5V13H10V5C10 2.243 7.757 0 5 0ZM5 2C6.654 2 8 3.346 8 5V11H2V5C2 3.346 3.346 2 5 2Z" fill="currentColor"/>
            </svg>
            Memory Management
          </a>
        </li>
        <li class="nav-item">
          <a href="/guides/orchestration" class="nav-link">
            <svg class="nav-icon" width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M7 0L0 4V10L7 14L14 10V4L7 0Z" fill="currentColor"/>
            </svg>
            Orchestration
          </a>
        </li>
      </ul>
    </div>

    <!-- Agent Guides Section -->
    <div class="nav-section">
      <h3 class="nav-heading">Agent Guides</h3>
      <ul class="nav-list">
        <li class="nav-item">
          <a href="/guides/defining-personalities" class="nav-link">
            <svg class="nav-icon" width="10" height="12" viewBox="0 0 10 12" fill="none">
              <path d="M5 0C2.239 0 0 2.239 0 5C0 7.761 5 12 5 12C5 12 10 7.761 10 5C10 2.239 7.761 0 5 0Z" fill="currentColor"/>
            </svg>
            Defining Personalities
          </a>
        </li>
        <li class="nav-item">
          <a href="/guides/writing-global-rules" class="nav-link active">
            <svg class="nav-icon" width="11" height="11" viewBox="0 0 11 11" fill="none">
              <path d="M5.5 0L0 5.5L5.5 11L11 5.5L5.5 0Z" fill="currentColor"/>
            </svg>
            Writing Global Rules
          </a>
        </li>
        <li class="nav-item">
          <a href="/guides/custom-tools" class="nav-link">
            <svg class="nav-icon" width="11" height="11" viewBox="0 0 11 11" fill="none">
              <path d="M5.5 0L0 5.5L5.5 11L11 5.5L5.5 0Z" fill="currentColor"/>
            </svg>
            Custom Tools
          </a>
        </li>
      </ul>
    </div>

    <!-- MCP Setup Section -->
    <div class="nav-section">
      <h3 class="nav-heading">MCP Setup</h3>
      <ul class="nav-list">
        <li class="nav-item">
          <a href="/guides/server-config" class="nav-link">
            <svg class="nav-icon" width="13" height="13" viewBox="0 0 13 13" fill="none">
              <path d="M6.5 0C2.91 0 0 2.91 0 6.5C0 10.09 2.91 13 6.5 13C10.09 13 13 10.09 13 6.5C13 2.91 10.09 0 6.5 0Z" fill="currentColor"/>
            </svg>
            Server Config
          </a>
        </li>
        <li class="nav-item">
          <a href="/guides/security-contexts" class="nav-link">
            <svg class="nav-icon" width="10" height="12" viewBox="0 0 10 12" fill="none">
              <path d="M5 0C2.239 0 0 2.239 0 5V12H10V5C10 2.239 7.761 0 5 0Z" fill="currentColor"/>
            </svg>
            Security Contexts
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <div class="sidebar-footer">
    <div class="user-settings">
      <div class="user-avatar">SK</div>
      <span class="user-name">User Settings</span>
      <svg class="settings-icon" width="12" height="12" viewBox="0 0 12 12" fill="none">
        <path d="M6 8L2 4H10L6 8Z" fill="currentColor"/>
      </svg>
    </div>
  </div>
</aside>

<style>
  .guides-sidebar {
    width: 288px;
    min-width: 288px;
    height: calc(100vh - 65px);
    background: rgba(10, 10, 15, 0.5);
    backdrop-filter: blur(6px);
    border-right: 1px solid rgba(124, 105, 247, 0.15);
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 65px;
  }

  .sidebar-header {
    padding: 24px;
    border-bottom: 1px solid transparent;
  }

  .sidebar-logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .logo-icon {
    width: 32px;
    height: 32px;
    background: #7c69f7;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-shadow: 0 10px 15px -3px rgba(124, 105, 247, 0.2);
  }

  .logo-icon svg {
    width: 16px;
    height: 16px;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
  }

  .logo-title {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: #f1f5f9;
    letter-spacing: -0.4px;
  }

  .logo-version {
    font-family: "Fira Code", monospace;
    font-size: 10px;
    color: rgba(124, 105, 247, 0.8);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
  }

  .nav-section {
    margin-bottom: 32px;
  }

  .nav-heading {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 700;
    font-size: 11px;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 2.2px;
    padding: 0 8px;
    margin-bottom: 12px;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 14px;
    color: #94a3b8;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .nav-link:hover {
    color: #cbd5e1;
    background: rgba(255, 255, 255, 0.02);
  }

  .nav-link.active {
    color: #7c69f7;
    font-weight: 500;
    background: rgba(124, 105, 247, 0.1);
    border-right: 2px solid #7c69f7;
  }

  .nav-icon {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    opacity: 0.7;
  }

  .nav-link.active .nav-icon {
    opacity: 1;
  }

  .sidebar-footer {
    padding: 24px;
    border-top: 1px solid rgba(124, 105, 247, 0.15);
  }

  .user-settings {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    background: rgba(30, 41, 59, 0.5);
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .user-settings:hover {
    background: rgba(30, 41, 59, 0.7);
  }

  .user-avatar {
    width: 24px;
    height: 24px;
    background: #334155;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 600;
    color: #94a3b8;
  }

  .user-name {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 500;
    font-size: 12px;
    color: #cbd5e1;
    flex: 1;
  }

  .settings-icon {
    color: #94a3b8;
  }
</style>
