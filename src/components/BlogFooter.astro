---
// Blog Footer Component - Figma Design
---

<footer class="blog-footer">
  <div class="footer-main">
    <div class="footer-brand">
      <div class="brand-header">
        <div class="brand-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="24" height="24" rx="6" fill="#7c69f7"/>
            <path d="M6 7.5h4.5v1.5H7.5v2.25h3v1.5h-3v3.75H6V7.5zm7.5 0h3c1.24 0 2.25 1.01 2.25 2.25s-1.01 2.25-2.25 2.25h-1.5v3H13.5V7.5zm3 3c.41 0 .75-.34.75-.75s-.34-.75-.75-.75h-1.5v1.5h1.5z" fill="white"/>
          </svg>
        </div>
        <span class="brand-text">agents.cli</span>
      </div>
      <p class="brand-description">
        Building the next generation of developer tools powered<br />
        by autonomous intelligence. Fully open source, built for<br />
        the terminal.
      </p>
    </div>

    <div class="footer-links-section">
      <div class="footer-column">
        <h4 class="column-heading">Resources</h4>
        <nav class="column-nav">
          <a href="/docs" class="column-link">Documentation</a>
          <a href="/api" class="column-link">API Reference</a>
          <a href="/community" class="column-link">Community Forum</a>
          <a href="/support" class="column-link">Support</a>
        </nav>
      </div>

      <div class="footer-column">
        <h4 class="column-heading">Company</h4>
        <nav class="column-nav">
          <a href="/about" class="column-link">About Us</a>
          <a href="/privacy" class="column-link">Privacy Policy</a>
          <a href="/terms" class="column-link">Terms of Service</a>
          <a href="/contact" class="column-link">Contact</a>
        </nav>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="bottom-border">
      <div class="bottom-content">
        <span class="copyright">© 2024 AGENTS.CLI — SYSTEM_STABLE_v2.4.0</span>
        <div class="social-links">
          <a href="https://github.com/agentscli" class="social-link" aria-label="GitHub">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M10 0C4.477 0 0 4.477 0 10c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.341-3.369-1.341-.454-1.155-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.349-1.086.635-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0110 4.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C17.137 18.163 20 14.418 20 10c0-5.523-4.477-10-10-10z" fill="currentColor"/>
            </svg>
          </a>
          <a href="https://twitter.com" class="social-link" aria-label="Twitter">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M18.258 5.314c-.582.258-1.208.433-1.866.512.67-.401 1.185-1.037 1.429-1.795-.628.372-1.324.643-2.065.789-.594-.632-1.441-1.027-2.379-1.027-1.8 0-3.261 1.46-3.261 3.261 0 .256.029.505.084.744-2.71-.136-5.112-1.433-6.719-3.406-.281.482-.442 1.043-.442 1.64 0 1.132.576 2.131 1.451 2.716-.535-.017-1.038-.164-1.478-.409v.041c0 1.58 1.124 2.897 2.614 3.197-.273.074-.561.114-.859.114-.21 0-.414-.02-.613-.058.414 1.294 1.617 2.236 3.042 2.262-1.115.874-2.52 1.395-4.049 1.395-.263 0-.523-.016-.779-.045 1.443.925 3.158 1.465 5.001 1.465 6.002 0 9.284-4.975 9.284-9.284 0-.142-.003-.283-.009-.423.638-.46 1.192-1.036 1.628-1.692z" fill="currentColor"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .blog-footer {
    background: var(--ac-surface);
    border-top: 1px solid var(--sl-color-hairline);
    padding: 49px 80px 48px;
    position: relative;
    z-index: 1;
  }

  .footer-main {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    gap: 48px;
    justify-content: flex-start;
    margin-bottom: 48px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 23.25px;
    max-width: 384px;
  }

  .brand-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .brand-icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .brand-icon svg {
    width: 100%;
    height: 100%;
  }

  .brand-text {
    font-family: 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 18px;
    font-weight: 500;
    color: var(--sl-color-white);
  }

  .brand-description {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 22.75px;
    color: var(--sl-color-gray-2);
    margin: 0;
  }

  .footer-links-section {
    display: flex;
    gap: 48px;
    margin-left: auto;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 244px;
  }

  .column-heading {
    font-family: 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 14px;
    font-weight: 500;
    color: var(--sl-color-white);
    margin: 0;
  }

  .column-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .column-link {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .column-link:hover {
    color: var(--sl-color-white);
  }

  .column-link:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .footer-bottom {
    max-width: 1280px;
    margin: 0 auto;
  }

  .bottom-border {
    border-top: 1px solid var(--sl-color-hairline);
    padding-top: 33px;
  }

  .bottom-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .copyright {
    font-family: 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    font-weight: 400;
    color: var(--sl-color-gray-2);
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-gray-2);
    transition: color 0.2s ease;
  }

  .social-link:hover {
    color: var(--sl-color-white);
  }

  .social-link:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .social-link svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 1200px) {
    .blog-footer {
      padding: 49px 40px 48px;
    }

    .footer-links-section {
      gap: 32px;
    }

    .footer-column {
      width: 200px;
    }
  }

  @media (max-width: 900px) {
    .footer-main {
      flex-direction: column;
      gap: 32px;
    }

    .footer-links-section {
      margin-left: 0;
      flex-wrap: wrap;
    }

    .footer-column {
      width: auto;
      min-width: 180px;
    }
  }

  @media (max-width: 768px) {
    .blog-footer {
      padding: 32px 24px;
    }

    .footer-main {
      flex-direction: column;
      gap: 32px;
      margin-bottom: 32px;
    }

    .footer-brand {
      max-width: 100%;
    }

    .footer-links-section {
      flex-direction: column;
      gap: 24px;
    }

    .footer-column {
      width: 100%;
    }

    .bottom-content {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }
</style>
