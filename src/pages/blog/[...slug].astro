---
// Individual Blog Post Page - Custom Figma Design
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { getHero } from '../../lib/cover';
import { isPublishedPost, getBlogPosts } from '../../lib/blog';

// Generate paths for all published blog posts (dated, not draft)
export async function getStaticPaths() {
  const blogPosts = (await getCollection('blog')).filter(isPublishedPost);

  return blogPosts.map(post => {
    // Extract slug from the post id (e.g., "blog/my-post" -> "my-post")
    const slug = post.id.replace('blog/', '');

    return {
      params: { slug },
      props: { post },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
const data = post.data as any;

// Author mapping
const authorMap: Record<string, { name: string; title: string }> = {
  sourabh: { name: 'Sourabh Kushwah', title: 'Software Engineer' },
  sanjay: { name: 'Sanjay Kushwah', title: 'Software Engineer' },
};

// Get author info
function getAuthor() {
  if (data.authors) {
    if (typeof data.authors === 'string') {
      return authorMap[data.authors] || { name: data.authors, title: '' };
    }
    if (typeof data.authors === 'object' && data.authors.name) {
      return { name: data.authors.name, title: data.authors.title || '' };
    }
  }
  return { name: 'Unknown', title: '' };
}

const author = getAuthor();

// Calculate read time
function calculateReadTime(wordCount: number): string {
  const minutes = Math.ceil(wordCount / 200);
  return `${minutes} min read`;
}

// Format date
function formatDate(date: Date): string {
  return date.toISOString().split('T')[0];
}

// Get word count from remark plugin frontmatter if available
const wordCount = (data as any).wordCount || 500;
const readTime = calculateReadTime(wordCount);
const formattedDate = formatDate(new Date(data.date));
const heroImage = getHero(post.id);

// Related posts: rank by shared tags, tiebreak on recency; pad with recent
// posts when tag overlap yields fewer than 3.
const allPosts = await getBlogPosts();
const myTags: string[] = data.tags || [];
const related = allPosts
  .filter(p => p.id !== post.id)
  .map(p => {
    const tags: string[] = (p.data as any).tags || [];
    const shared = tags.filter(t => myTags.includes(t));
    return { post: p, score: shared.length, sharedTag: shared[0] };
  })
  .sort(
    (a, b) =>
      b.score - a.score ||
      new Date((b.post.data as any).date).valueOf() -
        new Date((a.post.data as any).date).valueOf()
  )
  .slice(0, 3)
  .map(({ post: p, sharedTag }) => {
    const d = p.data as any;
    return {
      href: `/blog/${p.id.replace('blog/', '')}/`,
      title: d.title,
      description: d.description || d.excerpt,
      tag: sharedTag || (d.tags || [])[0],
      date: String(d.date),
      hero: getHero(p.id),
    };
  });
---

<BlogPostLayout
  title={data.title}
  description={data.description || data.excerpt}
  category={data.category || 'TECHNICAL GUIDES'}
  author={author}
  date={formattedDate}
  readTime={readTime}
  heroImage={heroImage}
>
  <Content />
  <RelatedPosts slot="related" posts={related} />
</BlogPostLayout>
