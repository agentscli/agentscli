---
// Blog listing - pages 2+ (/blog/2, /blog/3, …). Page 1 lives at ../blog.astro.
import BlogFeed from "../../components/BlogFeed.astro";
import { getBlogPosts, getAllTags, PAGE_SIZE, pageUrl } from "../../lib/blog";

export async function getStaticPaths() {
  const allPosts = await getBlogPosts();
  const allTags = getAllTags(allPosts);
  const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));

  // Only pages 2..totalPages; page 1 is served by /blog.
  const paths = [];
  for (let page = 2; page <= totalPages; page++) {
    const start = (page - 1) * PAGE_SIZE;
    paths.push({
      params: { page: String(page) },
      props: {
        posts: allPosts.slice(start, start + PAGE_SIZE),
        allTags,
        currentPage: page,
        totalPages,
        prevUrl: pageUrl(page - 1),
        nextUrl: page < totalPages ? pageUrl(page + 1) : null,
      },
    });
  }
  return paths;
}

const { posts, allTags, currentPage, totalPages, prevUrl, nextUrl } = Astro.props;
---

<BlogFeed
  posts={posts}
  allTags={allTags}
  currentPage={currentPage}
  totalPages={totalPages}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
/>
