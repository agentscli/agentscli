---
// Blog Sidebar Component - Figma Design
interface Props {
  activeCategory?: string;
}

const { activeCategory = "discoveries" } = Astro.props;

const categories = [
  { id: "discoveries", label: "Discoveries", icon: "discoveries" },
  { id: "comparisons", label: "Comparisons", icon: "comparisons" },
  { id: "tutorials", label: "Tutorials", icon: "tutorials" },
  { id: "cli", label: "Internal CLI", icon: "cli" },
];
---

<aside class="blog-sidebar">
  <div class="sidebar-section">
    <h3 class="sidebar-heading">System Categories</h3>
    <nav class="sidebar-nav">
      {categories.map((category) => (
        <a
          href={`/blog?category=${category.id}`}
          class:list={["sidebar-link", { active: activeCategory === category.id }]}
          data-track="sidebar-category"
          data-category={category.id}
        >
          <div class="link-icon">
            {category.icon === "discoveries" && (
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7.5 0C3.36 0 0 3.36 0 7.5s3.36 7.5 7.5 7.5 7.5-3.36 7.5-7.5S11.64 0 7.5 0zm0 13.5c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6z" fill="currentColor"/>
                <circle cx="7.5" cy="7.5" r="3" fill="currentColor"/>
              </svg>
            )}
            {category.icon === "comparisons" && (
              <svg width="15" height="14.25" viewBox="0 0 15 14.25" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 0h6.75v6.75H0V0zm8.25 0H15v6.75H8.25V0zM0 7.5h6.75v6.75H0V7.5zm8.25 0H15v6.75H8.25V7.5z" fill="currentColor"/>
              </svg>
            )}
            {category.icon === "tutorials" && (
              <svg width="16.5" height="12" viewBox="0 0 16.5 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 0h1.5v12H0V0zm3 0h1.5v12H3V0zm3 0h1.5v12H6V0zm3 0h1.5v12H9V0zm3 0h1.5v12H12V0zm3 0h1.5v12H15V0z" fill="currentColor"/>
              </svg>
            )}
            {category.icon === "cli" && (
              <svg width="15" height="12" viewBox="0 0 15 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 0h15v12H0V0zm1.5 1.5v9h12v-9h-12zm1.5 2.25L5.25 6 3 8.25V3.75z" fill="currentColor"/>
              </svg>
            )}
          </div>
          <span class="link-text">{category.label}</span>
        </a>
      ))}
    </nav>
  </div>

  <div class="cta-card">
    <h4 class="cta-title">Build the future</h4>
    <p class="cta-description">
      Join our engineering community and<br />
      help shape the multi-agent<br />
      orchestration landscape.
    </p>
    <a href="/careers" class="cta-button" data-track="cta-careers">VIEW_CAREERS</a>
  </div>
</aside>

<style>
  .blog-sidebar {
    display: flex;
    flex-direction: column;
    gap: 32px;
    width: 256px;
    flex-shrink: 0;
    height: 100%;
    overflow-y: auto;
    scrollbar-width: none;
  }
  
  .blog-sidebar::-webkit-scrollbar {
    display: none;
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sidebar-heading {
    font-family: 'Geist Mono', 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    font-weight: 500;
    color: #f1f5f9;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin: 0;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 13px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .sidebar-link:hover {
    background: rgba(124, 105, 247, 0.05);
    border-color: rgba(124, 105, 247, 0.1);
  }

  .sidebar-link.active {
    background: rgba(124, 105, 247, 0.1);
    border-color: rgba(124, 105, 247, 0.2);
  }

  .link-icon {
    width: 15px;
    height: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    flex-shrink: 0;
  }

  .sidebar-link.active .link-icon {
    color: #7c69f7;
  }

  .link-icon svg {
    width: 100%;
    height: 100%;
  }

  .link-text {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #94a3b8;
  }

  .sidebar-link.active .link-text {
    color: #7c69f7;
  }

  .cta-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 25px;
    background: #111118;
    border: 1px solid #1e1e26;
    border-radius: 12px;
  }

  .cta-title {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #f1f5f9;
    margin: 0;
  }

  .cta-description {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: #94a3b8;
    line-height: 19.5px;
    margin: 0 0 8px 0;
  }

  .cta-button {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 0;
    background: #1e293b;
    border: none;
    border-radius: 4px;
    font-family: 'Geist Mono', 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    font-weight: 500;
    color: #f1f5f9;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .cta-button:hover {
    background: #2d3a4f;
  }

  @media (max-width: 1024px) {
    .blog-sidebar {
      display: none;
    }
  }
</style>
