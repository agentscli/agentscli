---
// Blog Post Layout - Reusable template for all blog posts
// Based on Figma design: https://www.figma.com/design/tftGXh7s0UnPEKEuq7kNlY/AgentCLI?node-id=22-221
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BlogFooter from "../components/BlogFooter.astro";
import BlogHeader from "../components/BlogHeader.astro";
import Head from "../components/Head.astro";

interface Props {
  title: string;
  description?: string;
  category?: string;
  author?: {
    name: string;
    title?: string;
    avatar?: string;
  };
  date?: string;
  readTime?: string;
  heroImage?: ImageMetadata | string | null;
  hideNewsletter?: boolean;
}

const {
  title,
  description,
  category = "TECHNICAL GUIDES",
  author = { name: "Team", title: "agents.cli" },
  date,
  readTime = "5 min read",
  heroImage,
  hideNewsletter = false,
} = Astro.props;

// Format date if provided
const formattedDate = date
  ? new Date(date).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    })
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || title} />
    <title>{title} | agents.cli Blog</title>
    <Head />
  </head>
  <body>
    <div class="blog-post-container">
      <div class="grid-background"></div>
      <div class="grid-gradient"></div>

      <BlogHeader currentPath={Astro.url.pathname} />

      <!-- Article Header -->
      <header class="article-header">
        <nav class="breadcrumb-nav">
          <a href="/blog" class="breadcrumb-link">Blog</a>
          <span class="breadcrumb-separator">/</span>
          <span class="breadcrumb-category">{category}</span>
        </nav>

        <h1 class="article-title">{title}</h1>

        {description && <p class="article-subtitle">{description}</p>}

        <div class="article-meta">
          <div class="author-badge">
            <div class="author-avatar">
              {
                author.avatar ? (
                  <img src={author.avatar} alt={author.name} />
                ) : (
                  <svg
                    width="9.333"
                    height="9.333"
                    viewBox="0 0 12 12"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M6 6.5a3 3 0 100-6 3 3 0 000 6zM6 8c-3.5 0-5 2-5 3v.5h10V11c0-1-1.5-3-5-3z"
                      fill="#7c69f7"
                    />
                  </svg>
                )
              }
            </div>
            <span class="author-name">{author.name}</span>
          </div>
          {
            formattedDate && (
              <>
                <span class="meta-separator">•</span>
                <time class="meta-item">{formattedDate}</time>
              </>
            )
          }
          <span class="meta-separator">•</span>
          <div class="read-time">
            <svg
              class="read-time-icon"
              width="14"
              height="14"
              viewBox="0 0 14 14"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2"
              ></circle>
              <path
                d="M7 3.5v3.5l2.5 1.5"
                stroke="currentColor"
                stroke-width="1.2"
                stroke-linecap="round"></path>
            </svg>
            <span class="meta-item">{readTime}</span>
          </div>
        </div>
      </header>

      <!-- Hero Image -->
      <div class="hero-image-container">
        <div class="hero-image">
          {
            heroImage && typeof heroImage !== "string" ? (
              <Image
                src={heroImage}
                alt={title}
                widths={[640, 960, 1280, 1600]}
                sizes="(max-width: 768px) 100vw, 960px"
                loading="eager"
              />
            ) : heroImage ? (
              <img src={heroImage} alt={title} />
            ) : (
              <div class="hero-image-placeholder">
                <div class="hero-placeholder-icon">
                  <svg
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M8 5v2h2V5H8zm6 0v2h2V5h-2zM8 9v2h2V9H8zm6 0v2h2V9h-2zM8 13v2h2v-2H8zm6 0v2h2v-2h-2zM8 17v2h2v-2H8zm6 0v2h2v-2h-2z"
                      fill="currentColor"
                      opacity="0.7"
                    />
                    <rect
                      x="4"
                      y="3"
                      width="16"
                      height="18"
                      rx="2"
                      stroke="currentColor"
                      stroke-width="1.5"
                      fill="none"
                    />
                  </svg>
                </div>
              </div>
            )
          }
        </div>
      </div>

      <!-- Article Content -->
      <article class="article-content">
        <slot />
      </article>

      <!-- Author Footer -->
      <footer class="author-footer">
        <div class="author-footer-content">
          <div class="author-info">
            <div class="author-info-avatar">
              <div class="author-info-avatar-inner">
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 12 12"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M6 6.5a3 3 0 100-6 3 3 0 000 6zM6 8c-3.5 0-5 2-5 3v.5h10V11c0-1-1.5-3-5-3z"
                    fill="#7c69f7"></path>
                </svg>
              </div>
            </div>
            <div class="author-info-text">
              <span class="author-info-name">{author.name}</span>
              {
                author.title && (
                  <span class="author-info-title">{author.title}</span>
                )
              }
            </div>
          </div>
          <div class="author-actions">
            <button class="action-button" data-action="share">
              <svg
                width="14"
                height="15"
                viewBox="0 0 14 15"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M11.5 7.5a1 1 0 01-.3.71l-6 6a1 1 0 01-1.42-1.42L9.09 7.5 3.79 2.21A1 1 0 115.2.79l6 6a1 1 0 01.3.71z"
                  fill="currentColor"></path>
              </svg>
              Share
            </button>
            <button class="action-button" data-action="save">
              <svg
                width="11"
                height="14"
                viewBox="0 0 11 14"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M1 4.5v8a1 1 0 001 1h7a1 1 0 001-1v-8M0 2h11M3.5 2V1a1 1 0 011-1h2a1 1 0 011 1v1"
                  stroke="currentColor"
                  stroke-width="1.2"></path>
              </svg>
              Save
            </button>
          </div>
        </div>
      </footer>

      <!-- Newsletter Section -->
      {
        !hideNewsletter && (
          <section class="newsletter-section">
            <div class="newsletter-content">
              <h3 class="newsletter-title">Stay ahead of the curve</h3>
              <p class="newsletter-description">
                Get deep-dives into LLM orchestration and terminal automation
                delivered to your inbox every Tuesday.
              </p>
              <form class="newsletter-form">
                <input
                  type="email"
                  class="newsletter-input"
                  placeholder="Enter your email"
                  required
                />
                <button type="submit" class="newsletter-button">
                  Join
                </button>
              </form>
            </div>
          </section>
        )
      }

      <BlogFooter />
    </div>
  </body>
</html>

<style is:global>
  /* Import blog post styles */
  @import "../styles/blog-post.css";
</style>
