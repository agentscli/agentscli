---
// Blog Layout Component
import BlogHeader from "./BlogHeader.astro";
import BlogFooter from "./BlogFooter.astro";

---

<div class="blog-container">
  <BlogHeader />
  <main class="blog-main">
    <slot />
  </main>
  <BlogFooter />
</div>

<style>
  .blog-container {
    background-color: var(--page-bg);
    color: var(--text-primary);
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
  }

  .blog-main {
    position: relative;
    z-index: 1;
  }
</style>
