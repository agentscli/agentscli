---
// Custom Starlight ThemeSelect override: renders a single toggle button
// that flips between light and dark instead of the default 3-option dropdown.
---

<starlight-theme-toggle>
	<button
		type="button"
		class="theme-toggle"
		aria-label="Toggle color theme"
		aria-pressed="false"
		title="Toggle light/dark theme"
	>
		<svg class="icon-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
		</svg>
		<svg class="icon-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
		</svg>
	</button>
</starlight-theme-toggle>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		background-color: var(--sl-color-bg-nav);
		color: var(--sl-color-text);
		cursor: pointer;
		transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
	}
	.theme-toggle:hover {
		background-color: var(--sl-color-gray-6, var(--sl-color-gray-5));
		border-color: var(--sl-color-gray-4);
	}
	.theme-toggle:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}
	.theme-toggle svg {
		width: 1.1rem;
		height: 1.1rem;
	}
	/* Show sun in dark mode (click to go light), moon in light mode. */
	:global([data-theme='dark']) .theme-toggle .icon-moon,
	:global([data-theme='light']) .theme-toggle .icon-sun {
		display: none;
	}
</style>

<script>
	type Theme = 'auto' | 'dark' | 'light';

	const storageKey = 'starlight-theme';

	const parseTheme = (theme: unknown): Theme =>
		theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

	const loadTheme = (): Theme =>
		parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

	function storeTheme(theme: Theme): void {
		if (typeof localStorage !== 'undefined') {
			localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
		}
	}

	const getPreferredColorScheme = (): Theme =>
		matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

	function resolveTheme(theme: Theme): 'light' | 'dark' {
		return theme === 'auto' ? getPreferredColorScheme() : theme;
	}

	function applyTheme(theme: Theme): void {
		const resolved = resolveTheme(theme);
		document.documentElement.dataset.theme = resolved;
		storeTheme(theme);
		// Keep Starlight's other pickers (if any) in sync.
		// @ts-ignore - provided by Starlight's ThemeProvider.
		if (typeof StarlightThemeProvider !== 'undefined') StarlightThemeProvider.updatePickers(theme);
	}

	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (loadTheme() === 'auto') applyTheme('auto');
	});

	class StarlightThemeToggle extends HTMLElement {
		constructor() {
			super();
			applyTheme(loadTheme());
			const button = this.querySelector('button');
			const sync = () => {
				const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
				button?.setAttribute('aria-pressed', current === 'dark' ? 'true' : 'false');
			};
			sync();
			button?.addEventListener('click', () => {
				const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
				applyTheme(current === 'light' ? 'dark' : 'light');
				sync();
			});
		}
	}
	customElements.define('starlight-theme-toggle', StarlightThemeToggle);
</script>
