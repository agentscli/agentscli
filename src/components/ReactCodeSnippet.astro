---
import { Code } from 'astro:components';

interface Props {
  title?: string;
  bodyContent?: string;
  showLineNumber?: boolean;
  language?: any; // Allows Shiki strings like 'typescript', 'bash' etc.
}

const {
  title = '',
  bodyContent = '',
  showLineNumber = false,
  language = 'typescript'
} = Astro.props;

// Calculate line array for line numbers rendering
const lines = bodyContent.split('\n');
---

<div class="agent-code-block">
  <div class="agent-code-header">
    <div class="mac-dots">
      <span class="dot red"></span>
      <span class="dot yellow"></span>
      <span class="dot green"></span>
    </div>
    {title && <div class="file-path">{title}</div>}
    <div class="header-spacer"></div>
    {language && <div class="language-label">{language.toUpperCase()}</div>}
    
    <button class="agent-copy-btn" aria-label="Copy code" data-code={bodyContent}>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="copy-icon">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon" style="display: none;">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </button>
  </div>
  
  <div class="agent-code-inner">
    {showLineNumber && (
      <div class="line-numbers">
        {lines.map((_, i) => (
          <div class="line-number">{i + 1}</div>
        ))}
      </div>
    )}
    <div class="code-content-wrapper">
      <Code code={bodyContent} lang={language} theme="github-dark" />
    </div>
  </div>

  <div class="agent-badge-container">
    <div class="agent-badge">
      <span class="badge-dot"></span> AGENT ACTIVE
    </div>
  </div>
</div>

<script>
  // Add copy functionality to all code snippet buttons
  document.addEventListener('DOMContentLoaded', () => {
    const copyButtons = document.querySelectorAll('.agent-copy-btn');
    
    copyButtons.forEach(button => {
      button.addEventListener('click', async () => {
        const code = button.getAttribute('data-code');
        if (!code) return;
        
        try {
          await navigator.clipboard.writeText(code);
          
          // Show checkmark
          const copyIcon = button.querySelector('.copy-icon') as HTMLElement;
          const checkIcon = button.querySelector('.check-icon') as HTMLElement;
          
          if (copyIcon && checkIcon) {
            copyIcon.style.display = 'none';
            checkIcon.style.display = 'block';
            
            setTimeout(() => {
              copyIcon.style.display = 'block';
              checkIcon.style.display = 'none';
            }, 2000);
          }
        } catch (err) {
          console.error('Failed to copy code: ', err);
        }
      });
    });
  });
</script>

<style>
  .agent-code-block {
    background-color: #0d1117;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    overflow: hidden;
    margin: 40px 0;
    font-family: 'Google Sans Mono', 'Roboto Mono', 'Geist Mono', 'Fira Code', 'SF Mono', monospace;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    position: relative;
  }

  .agent-code-header {
    display: flex;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background-color: #0d1117;
  }

  .mac-dots {
    display: flex;
    gap: 6px;
    margin-right: 16px;
  }
  
  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .dot.red { background-color: #ff5f56; }
  .dot.yellow { background-color: #ffbd2e; }
  .dot.green { background-color: #27c93f; }

  .file-path {
    color: #8b949e;
    font-size: 13px;
  }

  .header-spacer { flex: 1; }

  .language-label {
    color: #484f58;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    margin-right: 12px;
  }

  .agent-copy-btn {
    background: transparent;
    border: none;
    color: #8b949e;
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .agent-copy-btn:hover {
    color: #e8e8f0;
    background: rgba(255, 255, 255, 0.1);
  }

  .agent-code-inner {
    display: flex;
    background-color: #0d1117;
  }

  /* Core Line Spacing variables to ensure perfect vertical sync */
  .line-numbers {
    padding: 20px 0;
    color: #484f58;
    font-size: 14px;
    text-align: right;
    user-select: none;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
  }

  .line-number {
    padding: 0 16px;
    line-height: 28px; /* Increased line spacing */
    height: 28px;
  }

  .code-content-wrapper {
    flex: 1;
    overflow-x: auto;
    padding: 20px 16px 20px 16px;
  }

  /* Override Astro <pre> native margin/padding */
  .code-content-wrapper :global(pre) {
    margin: 0 !important;
    padding: 0 !important;
    background: transparent !important;
    font-size: 14px !important;
  }
  
  .code-content-wrapper :global(code) {
    background: transparent !important;
    padding: 0 !important;
    border-radius: 0 !important;
    font-family: inherit !important;
    color: inherit !important;
    display: block;
  }

  /* Force Shiki generated .lines to match the line-number gutter exactly */
  .code-content-wrapper :global(.line) {
    line-height: 28px !important; /* Must perfectly match .line-number */
    min-height: 28px !important;
    display: inline-block;
    width: 100%;
  }

  .agent-badge-container {
    display: flex;
    justify-content: flex-end;
    padding: 8px 16px 16px;
    background-color: #0d1117;
  }

  .agent-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    background-color: rgba(39, 201, 63, 0.1);
    color: #27c93f;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
    border: 1px solid rgba(39, 201, 63, 0.2);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background-color: #27c93f;
    border-radius: 50%;
    box-shadow: 0 0 4px #27c93f;
  }
</style>
