---
// Blog Post Template Component - Based on Figma Design
import "../styles/blog-post.css";

interface Props {
  title: string;
  subtitle?: string;
  category?: string;
  author?: {
    name: string;
    title?: string;
    avatar?: string;
  };
  date?: string;
  readTime?: string;
  heroImage?: string;
}

const {
  title,
  subtitle,
  category = "Technical Guides",
  author = { name: "Alex Rivera", title: "Lead Architect @ agents.cli" },
  date = "Oct 24, 2023",
  readTime = "8 min read",
  heroImage,
} = Astro.props;
---

<div class="blog-post-container">
  <div class="grid-background"></div>
  <div class="grid-gradient"></div>

  <!-- Article Header -->
  <header class="article-header">
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb-nav">
      <a href="/blog" class="breadcrumb-link">Blog</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-category">{category}</span>
    </nav>

    <!-- Article Title -->
    <h1 class="article-title">{title}</h1>

    <!-- Article Subtitle -->
    {subtitle && <p class="article-subtitle">{subtitle}</p>}

    <!-- Article Meta -->
    <div class="article-meta">
      <div class="author-badge">
        <div class="author-avatar">
          {author.avatar ? (
            <img src={author.avatar} alt={author.name} />
          ) : (
            <svg width="9.333" height="9.333" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 6.5a3 3 0 100-6 3 3 0 000 6zM6 8c-3.5 0-5 2-5 3v.5h10V11c0-1-1.5-3-5-3z" fill="#7c69f7"/>
            </svg>
          )}
        </div>
        <span class="author-name">{author.name}</span>
      </div>
      <span class="meta-separator">•</span>
      <time class="meta-item">{date}</time>
      <span class="meta-separator">•</span>
      <div class="read-time">
        <svg class="read-time-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2"/>
          <path d="M7 3.5v3.5l2.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        <span class="meta-item">{readTime}</span>
      </div>
    </div>
  </header>

  <!-- Hero Image -->
  {heroImage && (
    <div class="hero-image-container">
      <div class="hero-image">
        <img src={heroImage} alt={title} />
      </div>
    </div>
  )}

  <!-- Article Content -->
  <article class="article-content">
    <slot />
  </article>

  <!-- Author Footer -->
  <footer class="author-footer">
    <div class="author-footer-content">
      <div class="author-info">
        <div class="author-info-avatar">
          <div class="author-info-avatar-inner">
            <svg width="16" height="16" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 6.5a3 3 0 100-6 3 3 0 000 6zM6 8c-3.5 0-5 2-5 3v.5h10V11c0-1-1.5-3-5-3z" fill="#7c69f7"/>
            </svg>
          </div>
        </div>
        <div class="author-info-text">
          <span class="author-info-name">{author.name}</span>
          {author.title && <span class="author-info-title">{author.title}</span>}
        </div>
      </div>
      <div class="author-actions">
        <button class="action-button">
          <svg class="action-button-icon" width="14" height="15" viewBox="0 0 14 15" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M11.5 7.5a1 1 0 01-.3.71l-6 6a1 1 0 01-1.42-1.42L9.09 7.5 3.79 2.21A1 1 0 115.2.79l6 6a1 1 0 01.3.71z" fill="currentColor"/>
          </svg>
          Share
        </button>
        <button class="action-button">
          <svg class="action-button-icon" width="11" height="14" viewBox="0 0 11 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 4.5v8a1 1 0 001 1h7a1 1 0 001-1v-8M0 2h11M3.5 2V1a1 1 0 011-1h2a1 1 0 011 1v1" stroke="currentColor" stroke-width="1.2"/>
          </svg>
          Save
        </button>
      </div>
    </div>
  </footer>

  <!-- Newsletter Section -->
  <section class="newsletter-section">
    <div class="newsletter-content">
      <h3 class="newsletter-title">Stay ahead of the curve</h3>
      <p class="newsletter-description">
        Get deep-dives into LLM orchestration and terminal automation<br />
        delivered to your inbox every Tuesday.
      </p>
      <form class="newsletter-form">
        <input
          type="email"
          class="newsletter-input"
          placeholder="Enter your email"
        />
        <button type="submit" class="newsletter-button">Join</button>
      </form>
    </div>
  </section>

  <!-- Site Footer -->
  <footer class="site-footer">
    <div class="site-footer-content">
      <div class="site-footer-brand">
        <svg class="site-footer-logo" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="24" height="24" rx="6" fill="#7c69f7"/>
          <path d="M6 7.5h4.5v1.5H7.5v2.25h3v1.5h-3v3.75H6V7.5zm7.5 0h3c1.24 0 2.25 1.01 2.25 2.25s-1.01 2.25-2.25 2.25h-1.5v3H13.5V7.5zm3 3c.41 0 .75-.34.75-.75s-.34-.75-.75-.75h-1.5v1.5h1.5z" fill="white"/>
        </svg>
        <span class="site-footer-name">agents.cli</span>
      </div>
      <span class="site-footer-copyright">© 2023 agents.cli. All rights reserved.</span>
      <div class="site-footer-social">
        <a href="https://github.com/agentscli" class="social-link" aria-label="GitHub">
          <svg width="16" height="17" viewBox="0 0 16 17" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 .5a7.5 7.5 0 00-2.37 14.62c.375.07.51-.162.51-.36v-1.26c-2.09.454-2.53-.996-2.53-.996-.342-.87-.835-1.1-.835-1.1-.682-.466.052-.457.052-.457.754.053 1.15.772 1.15.772.67 1.146 1.755.815 2.184.623.068-.486.262-.816.476-1.004-1.666-.19-3.417-.833-3.417-3.71 0-.82.293-1.49.773-2.016-.077-.19-.335-.953.073-1.987 0 0 .63-.202 2.06.77a7.18 7.18 0 013.75 0c1.43-.972 2.058-.77 2.058-.77.41 1.034.152 1.797.075 1.987.48.526.772 1.196.772 2.016 0 2.884-1.755 3.517-3.427 3.702.269.232.51.692.51 1.395v2.066c0 .2.134.433.515.36A7.5 7.5 0 008 .5z" fill="currentColor"/>
          </svg>
        </a>
        <a href="https://twitter.com" class="social-link" aria-label="Twitter">
          <svg width="17" height="14" viewBox="0 0 17 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15.03 3.674c.01.147.01.295.01.444 0 4.537-3.455 9.77-9.77 9.77A9.715 9.715 0 010 12.352c.273.032.538.044.82.044a6.88 6.88 0 004.263-1.468 3.44 3.44 0 01-3.213-2.385c.214.032.428.055.652.055.312 0 .623-.043.913-.122A3.437 3.437 0 01.68 5.097v-.043a3.46 3.46 0 001.55.435A3.44 3.44 0 01.724 2.605c0-.635.168-1.223.462-1.732a9.766 9.766 0 007.085 3.597 3.44 3.44 0 01-.085-.787 3.438 3.438 0 013.44-3.44c.99 0 1.886.418 2.517 1.09a6.763 6.763 0 002.183-.832 3.427 3.427 0 01-1.51 1.895 6.887 6.887 0 001.976-.53 6.93 6.93 0 01-1.72 1.778z" fill="currentColor"/>
          </svg>
        </a>
      </div>
    </div>
  </footer>
</div>
