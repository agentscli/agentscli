---
// UpstreamRefs - links to authoritative tool docs for a given chapter.
// Use at the bottom of foundations chapters. Specs evolve faster than chapters;
// readers should know where the source of truth lives.
interface Link {
  tool: string;
  url: string;
  label?: string;
}

interface Props {
  links: Link[];
  checkedAt: string;
}

const { links, checkedAt } = Astro.props;

for (const link of links) {
  let parsed: URL;
  try {
    parsed = new URL(link.url);
  } catch {
    throw new Error(`Invalid upstream URL for ${link.tool}: ${link.url}`);
  }
  if (parsed.protocol !== 'https:') {
    throw new Error(`Upstream URL must use HTTPS for ${link.tool}: ${link.url}`);
  }
}
---

<aside class="upstream-refs" aria-label="Official docs">
  <p class="upstream-refs-heading">Official docs</p>
  <ul class="upstream-refs-list">
    {links.map((link) => (
      <li>
        <a href={link.url} target="_blank" rel="noopener noreferrer">
          <span class="upstream-refs-tool">{link.tool}</span>
          {link.label && <span class="upstream-refs-label">, {link.label}</span>}
          <svg
            class="upstream-refs-arrow"
            width="12"
            height="12"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3.5 8.5l5-5M4 3.5h4.5V8"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </li>
    ))}
  </ul>
  <p class="upstream-refs-note">
    Specs evolve faster than chapters. Links checked {checkedAt}; when in doubt, the upstream wins.
  </p>
</aside>

<style>
  .upstream-refs {
    margin: 2.5rem 0 1rem;
    padding: 1rem 1.25rem 1.1rem;
    border: 1px solid rgba(124, 105, 247, 0.18);
    border-left: 3px solid #7c69f7;
    border-radius: 8px;
    background: rgba(124, 105, 247, 0.04);
  }

  .upstream-refs-heading {
    margin: 0 0 0.5rem;
    font-family: 'Geist Mono', 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 12px;
    font-weight: 500;
    color: var(--sl-color-accent);
    text-transform: uppercase;
    letter-spacing: 1.4px;
  }

  .upstream-refs-list {
    list-style: none;
    padding: 0;
    margin: 0 0 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .upstream-refs-list a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--sl-color-text);
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .upstream-refs-list a:hover {
    color: var(--sl-color-accent);
  }

  .upstream-refs-tool {
    font-weight: 600;
  }

  .upstream-refs-label {
    color: var(--sl-color-gray-3);
  }

  .upstream-refs-arrow {
    flex-shrink: 0;
    opacity: 0.6;
    transition: opacity 0.15s ease;
  }

  .upstream-refs-list a:hover .upstream-refs-arrow {
    opacity: 1;
  }

  .upstream-refs-note {
    margin: 0;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    font-style: italic;
  }
</style>
