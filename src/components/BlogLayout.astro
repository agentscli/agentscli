---
// Blog Layout Component
import BlogHeader from "./BlogHeader.astro";
import BlogFooter from "./BlogFooter.astro";

interface Props {
  title?: string;
}

const { title = "Engineering Blog | agents.cli" } = Astro.props;
---

<div class="blog-container">
  <div class="grid-background"></div>
  <div class="grid-gradient"></div>
  <BlogHeader />
  <main class="blog-main">
    <slot />
  </main>
  <BlogFooter />
</div>

<style>
  .blog-container {
    background-color: var(--sl-color-bg);
    color: var(--sl-color-white);
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
  }

  .grid-background {
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(90deg, var(--ac-grid-line) 2.5%, transparent 2.5%),
      linear-gradient(180deg, var(--ac-grid-line) 2.5%, transparent 2.5%);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  .grid-gradient {
    position: fixed;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--sl-color-bg) 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  .blog-main {
    position: relative;
    z-index: 1;
  }
</style>
