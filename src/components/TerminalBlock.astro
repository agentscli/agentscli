---
// Terminal Block Component - For code/terminal displays in blog posts
interface Props {
  title?: string;
  lines?: Array<{
    type: "prompt" | "command" | "output" | "success" | "warning" | "error";
    content: string;
    highlight?: string;
  }>;
}

const {
  title = "bash",
  lines = []
} = Astro.props;
---

<div class="terminal-block">
  <div class="terminal-header-bar">
    <div class="terminal-dots">
      <div class="terminal-dot red"></div>
      <div class="terminal-dot yellow"></div>
      <div class="terminal-dot green"></div>
    </div>
    <span class="terminal-title-text">{title}</span>
  </div>
  <div class="terminal-body">
    {lines.map((line) => (
      <div class="terminal-line">
        {line.type === "prompt" && (
          <>
            <span class="terminal-prompt">&gt;</span>
            <span class="terminal-cursor">_</span>
          </>
        )}
        {line.type === "command" && (
          <>
            <span class="terminal-prompt">&gt;</span>
            <span class="terminal-command">{line.content}</span>
          </>
        )}
        {line.type === "output" && (
          <>
            <span class="terminal-prompt" style="opacity: 0">&gt;</span>
            <span class="terminal-output">{line.content}</span>
          </>
        )}
        {line.type === "success" && (
          <>
            <span class="terminal-prompt" style="opacity: 0">&gt;</span>
            <span class="terminal-success">✔</span>
            <span class="terminal-output"> {line.content}</span>
          </>
        )}
        {line.type === "warning" && (
          <>
            <span class="terminal-prompt" style="opacity: 0">&gt;</span>
            <span class="terminal-warning">!</span>
            <span class="terminal-output"> {line.content}</span>
            {line.highlight && (
              <span class="terminal-code-inline">{line.highlight}</span>
            )}
          </>
        )}
        {line.type === "error" && (
          <>
            <span class="terminal-prompt" style="opacity: 0">&gt;</span>
            <span class="terminal-error">✗</span>
            <span class="terminal-output"> {line.content}</span>
          </>
        )}
      </div>
    ))}
    <slot />
  </div>
</div>

<style>
  .terminal-block {
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    margin: 56px 0;
  }

  .terminal-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px 9px;
    background: rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .terminal-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 9999px;
  }

  .terminal-dot.red { background: rgba(239, 68, 68, 0.5); }
  .terminal-dot.yellow { background: rgba(234, 179, 8, 0.5); }
  .terminal-dot.green { background: rgba(34, 197, 94, 0.5); }

  .terminal-title-text {
    font-family: 'Geist Mono', 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 10px;
    font-weight: 400;
    color: #9890cb;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .terminal-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .terminal-line {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-family: 'Geist Mono', 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 14px;
    line-height: 22.75px;
  }

  .terminal-prompt {
    color: #7c69f7;
    opacity: 0.5;
    flex-shrink: 0;
  }

  .terminal-command {
    color: #ffffff;
  }

  .terminal-output {
    color: #9890cb;
  }

  .terminal-success {
    color: #4ade80;
  }

  .terminal-warning {
    color: #facc15;
  }

  .terminal-error {
    color: #ef4444;
  }

  .terminal-cursor {
    color: #7c69f7;
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .terminal-code-inline {
    background: rgba(255, 255, 255, 0.1);
    padding: 2px 4px;
    border-radius: 4px;
    margin-left: 4px;
    color: #9890cb;
  }
</style>
