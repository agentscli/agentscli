---
// CodeSnippet Component
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang?: any;
  title?: string;
  showWindowControls?: boolean;
}

const {
  code,
  lang = 'ts',
  title,
  showWindowControls = false
} = Astro.props;
---

<div class="code-snippet-wrapper">
  {showWindowControls || title ? (
    <div class="code-snippet-header">
      <div class="window-controls">
        {showWindowControls && (
          <>
            <div class="control-dot close"></div>
            <div class="control-dot minimize"></div>
            <div class="control-dot maximize"></div>
          </>
        )}
      </div>
      {title && <div class="code-snippet-title">{title}</div>}
    </div>
  ) : null}
  <div class="code-snippet-body">
    {code ? <Code code={code} lang={lang} theme="dark-plus" /> : <slot />}
  </div>
</div>

<style>
  .code-snippet-wrapper {
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    overflow: hidden;
    margin: 40px 0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  .code-snippet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .window-controls {
    display: flex;
    gap: 8px;
    width: 60px; /* placeholder space if needed */
  }

  .control-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .close { background-color: rgba(239, 68, 68, 0.5); }
  .minimize { background-color: rgba(234, 179, 8, 0.5); }
  .maximize { background-color: rgba(34, 197, 94, 0.5); }

  .code-snippet-title {
    font-family: 'Geist Mono', 'Fira Code', 'SF Mono', Monaco, monospace;
    font-size: 11px;
    color: #9890cb;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-align: right;
    flex-grow: 1;
  }

  .code-snippet-body {
    padding: 16px 20px;
    overflow-x: auto;
  }
  
  /* Syntax highlighting override for Astro Code component */
  .code-snippet-body :global(pre) {
    background: transparent !important;
    margin: 0 !important;
    padding: 0 !important;
    font-size: 14px;
    line-height: 1.6;
    font-family: 'Geist Mono', 'Fira Code', 'SF Mono', Monaco, monospace;
  }
</style>
