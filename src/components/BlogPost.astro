---
// Blog Post Template Component - Based on Figma Design
import BlogFooter from "./BlogFooter.astro";
import "../styles/blog-post.css";

interface Props {
  title: string;
  subtitle?: string;
  category?: string;
  author?: {
    name: string;
    title?: string;
    avatar?: string;
  };
  date?: string;
  readTime?: string;
  heroImage?: string;
}

const {
  title,
  subtitle,
  category = "Technical Guides",
  author = { name: "Alex Rivera", title: "Lead Architect @ agents.cli" },
  date = "Oct 24, 2023",
  readTime = "8 min read",
  heroImage,
} = Astro.props;
---

<div class="blog-post-container">
  <div class="grid-background"></div>
  <div class="grid-gradient"></div>

  <!-- Article Header -->
  <header class="article-header">
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb-nav">
      <a href="/blog" class="breadcrumb-link">Blog</a>
      <span class="breadcrumb-separator">/</span>
      <span class="breadcrumb-category">{category}</span>
    </nav>

    <!-- Article Title -->
    <h1 class="article-title">{title}</h1>

    <!-- Article Subtitle -->
    {subtitle && <p class="article-subtitle">{subtitle}</p>}

    <!-- Article Meta -->
    <div class="article-meta">
      <div class="author-badge">
        <div class="author-avatar">
          {author.avatar ? (
            <img src={author.avatar} alt={author.name} />
          ) : (
            <svg width="9.333" height="9.333" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 6.5a3 3 0 100-6 3 3 0 000 6zM6 8c-3.5 0-5 2-5 3v.5h10V11c0-1-1.5-3-5-3z" fill="#7c69f7"/>
            </svg>
          )}
        </div>
        <span class="author-name">{author.name}</span>
      </div>
      <span class="meta-separator">•</span>
      <time class="meta-item">{date}</time>
      <span class="meta-separator">•</span>
      <div class="read-time">
        <svg class="read-time-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="7" cy="7" r="6" stroke="#9890cb" stroke-width="1.2"/>
          <path d="M7 3.5v3.5l2.5 1.5" stroke="#9890cb" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        <span class="meta-item">{readTime}</span>
      </div>
    </div>
  </header>

  <!-- Hero Image -->
  {heroImage && (
    <div class="hero-image-container">
      <div class="hero-image">
        <img src={heroImage} alt={title} />
      </div>
    </div>
  )}

  <!-- Article Content -->
  <article class="article-content">
    <slot />
  </article>

  <!-- Author Footer -->
  <footer class="author-footer">
    <div class="author-footer-content">
      <div class="author-info">
        <div class="author-info-avatar">
          <div class="author-info-avatar-inner">
            <svg width="16" height="16" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 6.5a3 3 0 100-6 3 3 0 000 6zM6 8c-3.5 0-5 2-5 3v.5h10V11c0-1-1.5-3-5-3z" fill="#7c69f7"/>
            </svg>
          </div>
        </div>
        <div class="author-info-text">
          <span class="author-info-name">{author.name}</span>
          {author.title && <span class="author-info-title">{author.title}</span>}
        </div>
      </div>
      <div class="author-actions">
        <button class="action-button">
          <svg class="action-button-icon" width="14" height="15" viewBox="0 0 14 15" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M11.5 7.5a1 1 0 01-.3.71l-6 6a1 1 0 01-1.42-1.42L9.09 7.5 3.79 2.21A1 1 0 115.2.79l6 6a1 1 0 01.3.71z" fill="currentColor"/>
          </svg>
          Share
        </button>
        <button class="action-button">
          <svg class="action-button-icon" width="11" height="14" viewBox="0 0 11 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 4.5v8a1 1 0 001 1h7a1 1 0 001-1v-8M0 2h11M3.5 2V1a1 1 0 011-1h2a1 1 0 011 1v1" stroke="currentColor" stroke-width="1.2"/>
          </svg>
          Save
        </button>
      </div>
    </div>
  </footer>

  <!-- Newsletter Section -->
  <section class="newsletter-section">
    <div class="newsletter-content">
      <h3 class="newsletter-title">Stay ahead of the curve</h3>
      <p class="newsletter-description">
        Get deep-dives into LLM orchestration and terminal automation<br />
        delivered to your inbox every Tuesday.
      </p>
      <form class="newsletter-form">
        <input
          type="email"
          class="newsletter-input"
          placeholder="Enter your email"
        />
        <button type="submit" class="newsletter-button">Join</button>
      </form>
    </div>
  </section>

  <BlogFooter />
</div>
