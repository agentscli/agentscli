---
import { Tabs, TabItem } from '@astrojs/starlight/components';
import { getEntry, render } from 'astro:content';
import { tools } from '../data/tools';

interface Props {
  chapter: string;
}

const { chapter } = Astro.props;

const loaded = await Promise.all(
  tools.map(async (tool) => {
    const entry = await getEntry('toolInstructions', `${tool.slug}/${chapter}`);
    if (!entry) return null;
    const { Content } = await render(entry);
    return { tool, Content };
  })
);

const rendered = loaded.filter((e): e is NonNullable<typeof e> => e !== null);
---

<Tabs syncKey="tool">
  {rendered.map(({ tool, Content }) => (
    <TabItem label={tool.label}>
      <Content />
    </TabItem>
  ))}
</Tabs>
